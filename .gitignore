# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Node (if used for testing)
node_modules/
# pnpm's package cache, which the Docker screenshot scripts' `pnpm install` leaves at the mounted checkout's root
/.pnpm-store/

# Build artifacts
mnt/
# What atm-cli/build.py generates for the build and the dashboard (what the plugin ships is committed)
/.generated/
# Rust (T-443): cargo's builds
/target/

# Python bytecode (tests/lib imports atm-cli's modules as a package)
__pycache__/

# Claude local state
.claude/

# Dashboard dev project
dashboard/node_modules/
# What `pnpm run build` makes for atm to embed (T-477): the page and CompMD's runtime; and the Python atm's copies of
# them (build/python-copy.ts, until T-454)
dashboard/dist/
/plugin/templates/tasks-dashboard.html
/plugin/assets/
dashboard/test-results/
dashboard/playwright-report/
dashboard/coverage/
# SvelteKit's generated files and its static adapter's output (build/finish-page.ts ships the page from there)
dashboard/.svelte-kit/
