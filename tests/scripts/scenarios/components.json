[
  {
    "name": "add suggests components from its files, without setting them",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": {
            "components": [
              { "id": "dashboard", "label": "Dashboard", "paths": ["dashboard/**", "plugin/templates/**"] },
              { "id": "atm-cli", "paths": ["atm-cli/**", "tests/scripts/**"] }
            ]
          },
          "tasks": []
        }
      }
    },
    "args": [
      "task",
      "add",
      "--name",
      "Both",
      "--type",
      "feature",
      "--file",
      "atm-cli/atm/x.py",
      "--file",
      "dashboard/src/a.ts"
    ],
    "expect": {
      "stdout": "Added T-001 Both\n  T-001: its files suggest the components dashboard, atm-cli (atm task edit T-001 --add-component dashboard --add-component atm-cli)\n"
    }
  },
  {
    "name": "add --components auto sets the components its files are in",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": {
            "components": [
              { "id": "dashboard", "paths": ["dashboard/**"] },
              { "id": "docs", "paths": ["docs/*"] }
            ]
          },
          "tasks": []
        }
      }
    },
    "args": [
      "task",
      "add",
      "--name",
      "A",
      "--type",
      "feature",
      "--file",
      "dashboard/src/lib/x.ts",
      "--components",
      "auto",
      "--json"
    ],
    "env": { "ATM_NOW": "2026-05-02T10:00:00Z", "ATM_AGENT": "alice" },
    "expect": {
      "json": [
        {
          "id": "T-001",
          "name": "A",
          "type": "feature",
          "description": "",
          "requirements": [],
          "use_cases": [],
          "status": "todo",
          "dependencies": [],
          "files": ["dashboard/src/lib/x.ts"],
          "created_at": "2026-05-02T10:00:00Z",
          "updated_at": "2026-05-02T10:00:00Z",
          "created_by": "alice",
          "updated_by": "alice",
          "components": ["dashboard"]
        }
      ]
    }
  },
  {
    "name": "edit --add-file suggests the components the new file is in; --components auto adds them",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": {
            "components": [
              { "id": "dashboard", "paths": ["dashboard/**"] },
              { "id": "docs", "paths": ["docs/*"] }
            ]
          },
          "tasks": [
            {
              "id": "T-1",
              "name": "a",
              "type": "feature",
              "status": "todo",
              "components": ["dashboard"],
              "files": ["dashboard/a.ts"]
            }
          ]
        }
      },
      "commands": [["sh", "-c", "\"$ATM\" task edit T-1 --add-file docs/guide.md > out.txt"]]
    },
    "args": ["task", "edit", "T-1", "--components", "auto"],
    "expect": {
      "stdout": "T-1: changed components\n",
      "files": {
        "out.txt": "T-1: changed files\n  T-1: its files suggest the component docs (atm task edit T-1 --add-component docs)\n"
      }
    }
  },
  {
    "name": "in a project with components, a task's component must be one of them",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": { "components": [{ "id": "dashboard", "paths": ["dashboard/**"] }] },
          "tasks": [{ "id": "T-1", "name": "a", "type": "feature", "status": "todo" }]
        }
      }
    },
    "args": ["task", "edit", "T-1", "--add-component", "server"],
    "expect": { "exit": 2, "stderrIncludes": ["no component 'server'; the components: dashboard"] }
  },
  {
    "name": "atm check warns about a task whose files match no component",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": { "components": [{ "id": "dashboard", "paths": ["dashboard/**"] }] },
          "tasks": [
            { "id": "T-1", "name": "a", "type": "feature", "status": "todo", "files": ["README.md"] },
            { "id": "T-2", "name": "b", "type": "feature", "status": "todo", "files": ["dashboard/x.ts"] },
            { "id": "T-3", "name": "c", "type": "feature", "status": "todo" }
          ]
        }
      }
    },
    "args": ["doctor"],
    "expect": {
      "stdout": "warning: T-1: its files match no component (meta.components' paths)\ntasks.json is fine (3 tasks, 1 warnings)\n"
    }
  },
  {
    "name": "meta.components is checked: paths are globs, review a mode",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": { "components": [{ "id": "dashboard", "paths": "dashboard/**" }] },
          "tasks": []
        }
      }
    },
    "args": ["project", "status"],
    "expect": {
      "exit": 1,
      "stderrIncludes": ["meta.components: 'dashboard''s paths must be a list of globs (strings)"]
    }
  },
  {
    "name": "components add --from-label --assign: the label becomes the component on every task, archived ones too; tasks its globs match get it as well (T-324)",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": { "labels": [{ "id": "dashboard", "label": "Dashboard" }, { "id": "ux" }] },
          "tasks": [
            { "id": "T-1", "status": "done", "labels": ["dashboard", "ux"], "files": ["dashboard/a.ts"] },
            { "id": "T-2", "status": "todo", "labels": ["dashboard"] },
            { "id": "T-3", "status": "todo", "files": ["dashboard/b.ts"] },
            { "id": "T-4", "status": "todo", "labels": ["ux"], "files": ["README.md"] }
          ]
        },
        ".agentic-task-manager/tasks-archive.json": {
          "tasks": [{ "id": "T-0", "status": "done", "labels": ["dashboard"] }]
        }
      }
    },
    "args": [
      "component",
      "add",
      "dashboard",
      "--path",
      "dashboard/**",
      "--path",
      "plugin/templates/**",
      "--from-label",
      "dashboard",
      "--assign"
    ],
    "expect": {
      "stdout": "Added the component dashboard: 3 tasks from the label dashboard, 1 more by their files.\n",
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": {
            "labels": [{ "id": "ux" }],
            "components": [
              { "id": "dashboard", "label": "Dashboard", "paths": ["dashboard/**", "plugin/templates/**"] }
            ]
          },
          "tasks": [
            {
              "id": "T-1",
              "status": "done",
              "labels": ["ux"],
              "files": ["dashboard/a.ts"],
              "components": ["dashboard"]
            },
            { "id": "T-2", "status": "todo", "components": ["dashboard"] },
            { "id": "T-3", "status": "todo", "files": ["dashboard/b.ts"], "components": ["dashboard"] },
            { "id": "T-4", "status": "todo", "labels": ["ux"], "files": ["README.md"] }
          ]
        },
        ".agentic-task-manager/tasks-archive.json": {
          "tasks": [{ "id": "T-0", "status": "done", "components": ["dashboard"] }]
        }
      }
    }
  },
  {
    "name": "components add by files alone, overlapping another component; --label and --review; --json (T-324)",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": { "components": [{ "id": "cli", "paths": ["atm-cli/**"] }] },
          "tasks": [
            { "id": "T-1", "status": "todo", "files": ["atm-cli/atm/server.py"], "components": ["cli"] },
            { "id": "T-2", "status": "todo", "files": ["atm-cli/atm/edit.py"], "components": ["cli"] }
          ]
        }
      }
    },
    "args": [
      "component",
      "add",
      "api",
      "--label",
      "REST API",
      "--path",
      "atm-cli/atm/server.py",
      "--review",
      "blocker",
      "--assign",
      "--json"
    ],
    "expect": {
      "json": {
        "component": { "id": "api", "label": "REST API", "paths": ["atm-cli/atm/server.py"], "review": "blocker" },
        "from_label": [],
        "by_files": ["T-1"]
      },
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": {
            "components": [
              { "id": "cli", "paths": ["atm-cli/**"] },
              { "id": "api", "label": "REST API", "paths": ["atm-cli/atm/server.py"], "review": "blocker" }
            ]
          },
          "tasks": [
            { "id": "T-1", "status": "todo", "files": ["atm-cli/atm/server.py"], "components": ["cli", "api"] },
            { "id": "T-2", "status": "todo", "files": ["atm-cli/atm/edit.py"], "components": ["cli"] }
          ]
        },
        ".agentic-task-manager/tasks-archive.json": false
      }
    }
  },
  {
    "name": "components lists them with their globs, review and task counts, archived tasks too (T-324)",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": {
            "components": [
              { "id": "dashboard", "label": "Dashboard", "paths": ["dashboard/**"], "review": "async" },
              { "id": "compmd" }
            ]
          },
          "tasks": [{ "id": "T-2", "status": "todo", "components": ["dashboard"] }]
        },
        ".agentic-task-manager/tasks-archive.json": {
          "tasks": [{ "id": "T-1", "status": "done", "components": ["dashboard"] }]
        }
      }
    },
    "args": ["component", "list"],
    "expect": {
      "stdout": "dashboard · “Dashboard” · dashboard/** · review async: 2 tasks\ncompmd · no paths: 0 tasks\n"
    }
  },
  {
    "name": "components without any says how to add one (T-324)",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [] } } },
    "args": ["component", "list"],
    "expect": { "stdout": "No components yet: atm component add <id> --path GLOB.\n" }
  },
  {
    "name": "components add refuses a component already there, writing nothing (T-324)",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": { "meta": { "components": [{ "id": "cli" }] }, "tasks": [] }
      }
    },
    "args": ["component", "add", "cli", "--path", "atm-cli/**"],
    "expect": {
      "exit": 2,
      "stderrIncludes": ["there is already a component 'cli'"],
      "files": { ".agentic-task-manager/tasks.json": { "meta": { "components": [{ "id": "cli" }] }, "tasks": [] } }
    }
  },
  {
    "name": "components add refuses a label no task has (a typo), writing nothing (T-324)",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": { "tasks": [{ "id": "T-1", "status": "todo", "labels": ["dashboard"] }] }
      }
    },
    "args": ["component", "add", "dashboard", "--from-label", "dashbaord"],
    "expect": {
      "exit": 2,
      "stderrIncludes": ["no task has the label 'dashbaord'"],
      "files": {
        ".agentic-task-manager/tasks.json": { "tasks": [{ "id": "T-1", "status": "todo", "labels": ["dashboard"] }] }
      }
    }
  },
  {
    "name": "components add checks its ID (T-324)",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [] } } },
    "args": ["component", "add", "a b"],
    "expect": { "exit": 2, "stderrIncludes": ["'a b': a component ID is letters, digits"] }
  },
  {
    "name": "components add --assign needs a glob (T-324)",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [] } } },
    "args": ["component", "add", "api", "--assign"],
    "expect": {
      "exit": 2,
      "stderrIncludes": ["--assign gives the component to the tasks its globs match: it needs --path"]
    }
  },
  {
    "name": "components edit --from-label --add-path --assign: a second label onto an existing component, the archive too, the new globs assigned (T-326)",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": {
            "labels": [{ "id": "atm-cli" }, { "id": "ux" }],
            "components": [{ "id": "cli", "label": "CLI", "paths": ["atm-cli/**"] }]
          },
          "tasks": [
            { "id": "T-1", "status": "done", "labels": ["atm-cli"], "components": ["cli"] },
            { "id": "T-2", "status": "todo", "labels": ["atm-cli", "ux"] },
            { "id": "T-3", "status": "todo", "files": ["plugin/scripts/atm"] },
            { "id": "T-4", "status": "todo", "files": ["atm-cli/atm/x.py"], "components": ["cli"] }
          ]
        },
        ".agentic-task-manager/tasks-archive.json": {
          "tasks": [{ "id": "T-0", "status": "done", "labels": ["atm-cli"] }]
        }
      }
    },
    "args": [
      "component",
      "edit",
      "cli",
      "--add-path",
      "plugin/scripts/**",
      "--add-path",
      "atm-cli/**",
      "--from-label",
      "atm-cli",
      "--assign"
    ],
    "expect": {
      "stdout": "cli: changed paths, 3 tasks from the label atm-cli, 1 more by their files\n",
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": {
            "labels": [{ "id": "ux" }],
            "components": [{ "id": "cli", "label": "CLI", "paths": ["atm-cli/**", "plugin/scripts/**"] }]
          },
          "tasks": [
            { "id": "T-1", "status": "done", "components": ["cli"] },
            { "id": "T-2", "status": "todo", "labels": ["ux"], "components": ["cli"] },
            { "id": "T-3", "status": "todo", "files": ["plugin/scripts/atm"], "components": ["cli"] },
            { "id": "T-4", "status": "todo", "files": ["atm-cli/atm/x.py"], "components": ["cli"] }
          ]
        },
        ".agentic-task-manager/tasks-archive.json": {
          "tasks": [{ "id": "T-0", "status": "done", "components": ["cli"] }]
        }
      }
    }
  },
  {
    "name": "components edit --label and --review set them; empty removes them; --json (T-326)",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": { "components": [{ "id": "api", "label": "API", "paths": ["server.py"] }] },
          "tasks": []
        }
      }
    },
    "args": ["component", "edit", "api", "--label", "", "--review", "blocker", "--json"],
    "expect": {
      "json": {
        "component": { "id": "api", "paths": ["server.py"], "review": "blocker" },
        "changed": ["label", "review"],
        "from_label": [],
        "by_files": []
      },
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": { "components": [{ "id": "api", "paths": ["server.py"], "review": "blocker" }] },
          "tasks": []
        }
      }
    }
  },
  {
    "name": "components edit with nothing to change says so (T-326)",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": { "meta": { "components": [{ "id": "api", "paths": ["a"] }] }, "tasks": [] }
      }
    },
    "args": ["component", "edit", "api", "--add-path", "a"],
    "expect": { "stdout": "api: nothing changed\n" }
  },
  {
    "name": "components edit refuses an unknown component, naming them (T-326)",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": { "meta": { "components": [{ "id": "cli" }] }, "tasks": [] }
      }
    },
    "args": ["component", "edit", "api", "--from-label", "server"],
    "expect": { "exit": 2, "stderrIncludes": ["no component 'api'; the components: cli"] }
  },
  {
    "name": "components edit --assign on a component without globs is refused (T-326)",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": { "meta": { "components": [{ "id": "compmd" }] }, "tasks": [] }
      }
    },
    "args": ["component", "edit", "compmd", "--assign"],
    "expect": { "exit": 2, "stderrIncludes": ["--assign gives compmd to the tasks its globs match, and it has none"] }
  },
  {
    "name": "components: add takes --path, edit --add-path (T-326)",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": { "meta": { "components": [{ "id": "cli" }] }, "tasks": [] }
      }
    },
    "args": ["component", "edit", "cli", "--path", "x/**"],
    "expect": { "exit": 2, "stderrIncludes": ["atm: No such option: --path", "Usage: atm component edit"] },
    "expectRust": {
      "stderrIncludes": ["atm: unexpected argument '--path' found", "Usage: atm component edit"]
    }
  },
  {
    "name": "components: add's options are refused when listing (T-324)",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [] } } },
    "args": ["component", "list", "--from-label", "x"],
    "expect": { "exit": 2, "stderrIncludes": ["atm: No such option: --from-label"] },
    "expectRust": { "stderrIncludes": ["atm: unexpected argument '--from-label' found"] }
  }
]
