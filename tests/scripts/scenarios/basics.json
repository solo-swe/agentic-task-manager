[
  {
    "name": "version prints the plugin version",
    "args": ["version"],
    "expect": { "exit": 0, "stdout": "{version}\n" }
  },
  {
    "name": "no command prints the help",
    "args": [],
    "expect": {
      "exit": 0,
      "stdoutIncludes": ["Usage: atm [OPTIONS] COMMAND [ARGS]...", "  task ", "  loop ", "  project "]
    }
  },
  {
    "name": "help prints the help",
    "args": ["help"],
    "expect": { "exit": 0, "stdoutIncludes": ["Usage: atm [OPTIONS] COMMAND [ARGS]..."] }
  },
  {
    "name": "an unknown command is a usage error",
    "args": ["frobnicate"],
    "expect": {
      "exit": 2,
      "stdout": "",
      "stderrIncludes": ["atm: No such command 'frobnicate'.", "Usage: atm [OPTIONS] COMMAND [ARGS]..."]
    }
  },
  {
    "name": "version --json",
    "args": ["version", "--json"],
    "expect": { "exit": 0, "json": { "version": "{version}" } }
  },
  {
    "name": "--help on a command describes it",
    "args": ["task", "state", "--help"],
    "expect": {
      "exit": 0,
      "stdoutIncludes": [
        "Usage: atm task state [OPTIONS] TASK_ID NEXT_STATE",
        "--agent",
        "--question",
        "Move a task to another state"
      ]
    }
  },
  {
    "name": "a group's help lists its commands",
    "args": ["vcs", "--help"],
    "expect": {
      "exit": 0,
      "stdoutIncludes": ["Usage: atm vcs [OPTIONS] COMMAND [ARGS]...", "commit", "pr", "repository"]
    }
  },
  {
    "name": "help says every command takes --json, anywhere on the line, and how --dir works",
    "args": ["help"],
    "expect": {
      "exit": 0,
      "stdoutIncludes": [
        "Every command takes --json (-j) and --dry-run (-n), anywhere on the line.",
        "atm --dir PATH <command> runs as if started in PATH."
      ]
    }
  },
  {
    "name": "a usage error names the problem and the command's usage",
    "args": ["loop", "next", "--bogus"],
    "expect": {
      "exit": 2,
      "stdout": "",
      "stderrIncludes": ["atm: No such option: --bogus", "Usage: atm loop next [OPTIONS]"]
    }
  },
  {
    "name": "an option's value is checked",
    "args": ["release", "add", "1.0", "--pr", "one"],
    "expect": { "exit": 2, "stderrIncludes": ["atm: Invalid value for '--pr': 'one' is not a valid integer."] }
  },
  {
    "name": "with --json, a usage error is JSON on stderr, with the same exit code",
    "args": ["task", "state", "--json"],
    "expect": {
      "exit": 2,
      "stdout": "",
      "stderrIncludes": ["\"error\": \"Missing argument 'TASK_ID'.\"", "\"code\": 2"]
    }
  },
  {
    "name": "with --json, any other error is JSON too",
    "args": ["task", "state", "T-1", "done", "--json"],
    "expect": { "exit": 1, "stderrIncludes": ["\"error\": \"no tasks.json in", "\"code\": 1"] }
  },
  {
    "name": "with --json, an unknown command is JSON",
    "args": ["frobnicate", "--json"],
    "expect": { "exit": 2, "stdout": "", "stderrIncludes": ["\"error\": \"No such command 'frobnicate'.\""] }
  }
]
