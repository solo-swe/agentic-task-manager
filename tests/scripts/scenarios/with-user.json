[
  {
    "name": "next skips work done together with the user, unless --with-user (SR-3.5)",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            { "id": "T-1", "name": "Together", "type": "feature", "status": "todo", "with": "user", "priority": "P0" },
            { "id": "T-2", "name": "Alone", "type": "feature", "status": "todo" }
          ]
        }
      },
      "commands": [["sh", "-c", "\"$ATM\" loop next --with-user > together.txt"]]
    },
    "args": ["loop", "next"],
    "expect": {
      "stdout": "Next: T-2 Alone (backlog, feature)\n",
      "files": { "together.txt": "Next: T-1 Together (backlog, feature)\n" }
    }
  },
  {
    "name": "only work together left: next says so; start still takes it; list --with-user lists it",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [{ "id": "T-1", "name": "Together", "type": "feature", "status": "todo", "with": "user" }]
        }
      },
      "commands": [
        [
          "sh",
          "-c",
          "\"$ATM\" loop next > next.txt; \"$ATM\" task list --with-user > list.txt; \"$ATM\" task state T-1 in_progress > start.txt"
        ]
      ]
    },
    "args": ["task", "details", "T-1", "--json"],
    "expect": {
      "stdoutIncludes": ["\"status\": \"in_progress\""],
      "files": {
        "next.txt": "No task available: only work done together with the user is left in the tasks: T-1 (--with-user takes it).\n",
        "list.txt": "T-1  todo  P2  Together\n1 task: 1 todo\n"
      }
    }
  },
  {
    "name": "add --with user and edit --with '' set and remove it",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": { "tasks": [] }
      },
      "commands": [["sh", "-c", "\"$ATM\" task add --name A --type docs --with user > add.txt"]]
    },
    "args": ["task", "edit", "T-001", "--with", ""],
    "expect": {
      "stdout": "T-001: changed with\n",
      "files": { "add.txt": "Added T-001 A\n" }
    }
  },
  {
    "name": "migrate gives tasks labelled interactive with: user, finished ones too, and moves the label to it, once (SR-6.5, ATM-721)",
    "setup": {
      "files": {
        ".agentic-task-manager/.gitignore": "tasks-dashboard.html\n.server.json\n.server.log\nclaims.json\nclaims-store.json\n.lock/\n",
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            { "id": "T-1", "status": "todo", "labels": ["interactive"] },
            { "id": "T-2", "status": "done", "labels": ["interactive"] },
            { "id": "T-3", "status": "todo" }
          ]
        }
      }
    },
    "args": ["db", "migrate"],
    "expect": {
      "stdout": "Gave 1 task labelled interactive `with: user` (done together with you; unattended loops skip them).\nMoved the label interactive to `with: user` on 2 tasks, finished ones too: `with: user` alone says the work was done with you.\n",
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": { "migrations": ["interactive-label", "interactive-label-moved"] },
          "tasks": [
            { "id": "T-1", "status": "todo", "with": "user" },
            { "id": "T-2", "status": "done", "with": "user" },
            { "id": "T-3", "status": "todo" }
          ]
        }
      }
    }
  },
  {
    "name": "a project that ran the first migration still gets the label moved, once (ATM-721)",
    "setup": {
      "files": {
        ".agentic-task-manager/.gitignore": "tasks-dashboard.html\n.server.json\n.server.log\nclaims.json\nclaims-store.json\n.lock/\n",
        ".agentic-task-manager/tasks.json": {
          "meta": { "migrations": ["interactive-label"] },
          "tasks": [{ "id": "T-1", "status": "done", "labels": ["interactive", "ux"] }]
        }
      }
    },
    "args": ["db", "migrate"],
    "expect": {
      "stdout": "Moved the label interactive to `with: user` on 1 task, finished ones too: `with: user` alone says the work was done with you.\n",
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": { "migrations": ["interactive-label", "interactive-label-moved"] },
          "tasks": [{ "id": "T-1", "status": "done", "labels": ["ux"], "with": "user" }]
        }
      }
    }
  },
  {
    "name": "once migrated, the label put back or a with taken off is left as it is",
    "setup": {
      "files": {
        ".agentic-task-manager/.gitignore": "tasks-dashboard.html\n.server.json\n.server.log\nclaims.json\nclaims-store.json\n.lock/\n",
        ".agentic-task-manager/tasks.json": {
          "meta": { "migrations": ["interactive-label", "interactive-label-moved"] },
          "tasks": [{ "id": "T-1", "status": "todo", "labels": ["interactive"] }]
        }
      }
    },
    "args": ["db", "migrate"],
    "expect": { "stdout": "Nothing to migrate.\n" }
  }
]
