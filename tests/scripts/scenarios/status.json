    "args": ["task", "state"],
    "expect": {
      "exit": 2,
      "stderrIncludes": ["atm: Missing argument 'TASK_ID'.", "Usage: atm task state [OPTIONS] TASK_ID NEXT_STATE"]
    },
    "expectRust": {
