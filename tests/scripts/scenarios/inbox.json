[
  {
    "name": "inbox add: a person notes something; it is IN-1, open, by them",
    "setup": {
      "files": { ".agentic-task-manager/tasks.json": { "tasks": [] } }
    },
    "env": { "ATM_AGENT": "Ana", "ATM_NOW": "2026-11-24T09:00:00Z" },
    "args": ["inbox", "add", "Fix the sidebar's **scope**\n\nIt forgets the project."],
    "expect": {
      "stdout": "IN-1: added · Fix the sidebar's **scope**\n",
      "files": {
        ".agentic-task-manager/inbox.json": {
          "version": 1,
          "next": 2,
          "items": [
            {
              "id": "IN-1",
              "text": "Fix the sidebar's **scope**\n\nIt forgets the project.",
              "state": "created",
              "created_at": "2026-11-24T09:00:00Z",
              "created_by": "Ana",
              "updated_at": "2026-11-24T09:00:00Z"
            }
          ]
        }
      }
    }
  },
  {
    "name": "inbox add from a file, as JSON",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": { "tasks": [] },
        "note.md": "From a file\n"
      }
    },
    "env": { "ATM_AGENT": "Ana" },
    "args": ["inbox", "add", "--text-file", "note.md", "--json"],
    "expect": {
      "stdoutIncludes": ["\"id\": \"IN-1\"", "\"text\": \"From a file\"", "\"state\": \"created\""]
    }
  },
  {
    "name": "inbox add refuses an agent: the inbox is the user's input",
    "setup": {
      "files": { ".agentic-task-manager/tasks.json": { "tasks": [] } }
    },
    "env": { "ATM_AGENT": "claude:abc" },
    "args": ["inbox", "add", "Something"],
    "expect": {
      "exit": 1,
      "stderrIncludes": ["only a person adds to its project's inbox"],
      "files": { ".agentic-task-manager/inbox.json": false }
    }
  },
  {
    "name": "inbox add --project: an agent leaves a finding in another registered project's inbox, from this one (ATM-772)",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": { "id": "lfb00001", "key": "LFB" },
          "tasks": []
        },
        "atm/.agentic-task-manager/tasks.json": {
          "meta": { "id": "atm00001", "key": "ATM" },
          "tasks": []
        }
      },
      "commands": [["sh", "-c", "ATM_HOME=\"$PWD/.atm-home\" \"$ATM\" workspace add-project default atm"]]
    },
    "env": { "ATM_AGENT": "claude:abc", "ATM_NOW": "2026-11-24T09:00:00Z" },
    "args": ["inbox", "add", "--project", "atm", "Your API answers 500 on an empty body\n\nSeen from LFB's client."],
    "expect": {
      "stdout": "IN-1: added to ATM's inbox · Your API answers 500 on an empty body\n",
      "files": {
        "atm/.agentic-task-manager/inbox.json": {
          "version": 1,
          "next": 2,
          "items": [
            {
              "id": "IN-1",
              "text": "Your API answers 500 on an empty body\n\nSeen from LFB's client.",
              "state": "created",
              "created_at": "2026-11-24T09:00:00Z",
              "created_by": "claude:abc",
              "updated_at": "2026-11-24T09:00:00Z",
              "from_project": "LFB"
            }
          ]
        },
        ".agentic-task-manager/inbox.json": false
      }
    }
  },
