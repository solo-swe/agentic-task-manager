{
  "about": "What a host sends with CompMD's files (ADR-006), by path under CompMD's version folder. `files`: the page's own, compmd.js and its WebAssembly, which atm serves (and the app on atm:) with its headers; serve.test.mjs checks atm serve, app/src-tauri/src/lib.rs the app's atm: scheme. `bundle`: CompMD 0.7.0's serving contract (hosting.md, decision 8), which compmd-host's `respond` sends for the bundle under compmd/, in atm serve as in the app's plugin; {hash} is the frames' hash in the bundle's manifest. null: the header is not sent.",
  "files": {
    "compmd.js": {
      "content-type": "text/javascript; charset=utf-8",
      "access-control-allow-origin": "*",
      "x-content-type-options": "nosniff",
      "cache-control": "no-cache",
      "content-security-policy": null
    },
    "compmd_wasm_bg.wasm": {
      "content-type": "application/wasm",
      "access-control-allow-origin": "*",
      "x-content-type-options": "nosniff",
      "cache-control": "no-cache",
      "content-security-policy": null
    }
  },
  "bundle": {
    "compmd/frames/{hash}/strict.html": {
      "content-type": "text/html; charset=utf-8",
      "access-control-allow-origin": "*",
      "access-control-expose-headers": "*",
      "x-content-type-options": "nosniff",
      "cache-control": "max-age=31536000, immutable",
      "content-security-policy": "sandbox allow-scripts"
    },
    "compmd/frames/{hash}/permissive.html": {
      "content-type": "text/html; charset=utf-8",
      "access-control-allow-origin": "*",
      "access-control-expose-headers": "*",
      "x-content-type-options": "nosniff",
      "cache-control": "max-age=31536000, immutable",
      "content-security-policy": "sandbox allow-scripts"
    },
    "compmd/frames/{hash}/runtime.js": {
      "content-type": "text/javascript; charset=utf-8",
      "access-control-allow-origin": "*",
      "access-control-expose-headers": "*",
      "x-content-type-options": "nosniff",
      "cache-control": "max-age=31536000, immutable",
      "content-security-policy": "sandbox allow-scripts"
    },
    "compmd/packs/@comp-markdown/mermaid@0.1.1/dist/mermaid.js": {
      "content-type": "text/javascript; charset=utf-8",
      "access-control-allow-origin": "*",
      "access-control-expose-headers": "*",
      "x-content-type-options": "nosniff",
      "cache-control": "max-age=31536000, immutable",
      "content-security-policy": "sandbox allow-scripts"
    }
  }
}
