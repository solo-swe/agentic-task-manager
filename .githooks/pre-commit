#!/bin/sh
# Rebuild the committed build artifact whenever its inputs are part of the commit, so it never goes stale: atm-cli
# (plugin/scripts/atm.py, until T-454). CI checks the same thing (see .github/workflows/ci.yml). The dashboard isn't
# committed since T-477: CI and the release build it before atm.
# Enabled by `pnpm install` in dashboard/ (the "prepare" script sets core.hooksPath to .githooks).
if git diff --cached --name-only | grep -qE '^(atm-cli/|crates/atm-common/schema/)'; then
  echo "pre-commit: rebuilding plugin/scripts/atm.py"
  python3 atm-cli/build.py || { echo "pre-commit: atm-cli build failed"; exit 1; }
  git add plugin/scripts/atm.py
fi
