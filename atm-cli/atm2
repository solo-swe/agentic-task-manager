#!/bin/sh
# atm2: the Typer-based command tree for atm (experimental), over the same atm-lib calls as `atm`.
dir=$(cd "$(dirname "$0")" && pwd)

if command -v uv >/dev/null 2>&1; then
  # --project, not --directory: atm2 works on the project it is run in, so the working directory must stay
  exec uv run --quiet --project "$dir" python "$dir/atm/cli/atm2_main.py" "$@"
fi
if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; then
  exec python3 "$dir/atm/cli/atm2_main.py" "$@"
fi
echo "atm2: needs Python 3.9 or newer (python3). Install it and try again." >&2
exit 127
