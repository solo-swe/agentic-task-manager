{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: the app's own commands, the reads (and their subscriptions), connecting agents and installing an update on the user's click, nothing else (no core or plugin APIs: the updater only through the app's two commands)",
  "windows": ["main"],
  "permissions": [
    "allow-version",
    "allow-list-workspaces",
    "allow-list-projects",
    "allow-search",
    "allow-project-tasks",
    "allow-claims",
    "allow-worktrees",
    "allow-document",
    "allow-file",
    "allow-logo",
    "allow-subscribe-workspace",
    "allow-subscribe-project",
    "allow-unsubscribe",
    "allow-agents-status",
    "allow-connect-agents",
    "allow-subscribe-links",
    "allow-check-update",
    "allow-install-update"
  ]
}
