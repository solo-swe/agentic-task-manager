#!/bin/sh
# atm: the Agentic Task Manager helper. Runs atm.py with Python 3.9+ (its libraries are in vendor/). It execs, so the
# caller's shell is atm's parent: `atm claim hold` follows it.
dir=$(cd "$(dirname "$0")" && pwd)

if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; then
  exec python3 "$dir/atm.py" "$@"
fi
echo "atm: needs Python 3.9 or newer (python3). Install it and try again." >&2
exit 127
