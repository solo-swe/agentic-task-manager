+        ("CR--3fa1", None),
+        ("CR-7", None),
+        ("cr-7-3fa1", None),
+        ("counter.json", None),
+        ("notes", None),
+    ] {
+        assert_eq!(super::folder_number(name), number, "{name}");
+    }
