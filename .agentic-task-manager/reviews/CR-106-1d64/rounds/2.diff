+    std::fs::write(fine_rounds.join("1.diff"), "").unwrap();
+    std::fs::write(fine_rounds.join("notes.json"), "{").unwrap();
+    let store = FileStore::open(&task_dir).unwrap();
+    let listed: Vec<String> = store
