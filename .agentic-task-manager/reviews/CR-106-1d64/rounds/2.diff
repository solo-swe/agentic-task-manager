+        vcs.file_in(&rebuilt, "a.rs").as_deref(),
+        Some("fn a() { 1 }\n")
+    );
+    assert_eq!(vcs.file_in(&rebuilt, "img.png"), None);
+    assert_eq!(vcs.file_in(&rebuilt, TASKS).as_deref(), Some("{}\n"));
+    assert!(matches!(
+        from_working(&vcs, "nope", &Actor::from("claude:A")),
+        Err(atm_common::Error::Invalid(_))
+    ));
+}
