+    let rounds = plant(&task_dir, 2, "Linked rounds", "2026-11-17T03:00:00Z");
+    let elsewhere = dir.path().join("rounds");
+    std::fs::create_dir_all(&elsewhere).unwrap();
+    std::os::unix::fs::symlink(
