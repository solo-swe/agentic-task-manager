+const onLines = (id: string, more: Partial<PlacedDraft> = {}): PlacedDraft =>
+  ({
+    id,
+    at: '2026-11-19T11:00:00Z',
+    body: `Draft ${id}`,
+    kind: 'comment',
+    path: 'b.rs',
