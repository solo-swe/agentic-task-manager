-fn hook_inbox(cwd: &Path, agent: Option<&str>) -> u8 {
-    use std::io::Read;
-    let mut text = String::new();
-    if std::io::stdin()
-        .take(HOOK_INPUT_BYTES)
-        .read_to_string(&mut text)
-        .is_err()
