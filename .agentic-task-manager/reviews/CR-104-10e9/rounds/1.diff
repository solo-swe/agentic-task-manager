-        .and_then(|m| m.modified())
-        .ok()?
-        .duration_since(std::time::UNIX_EPOCH)
-        .ok()?
-        .as_secs();
-    Some(atm_common::time::format_iso(
-        i64::try_from(secs).unwrap_or(i64::MAX) - CHANGED_SLACK_SECS,
