-    let chains = review
-        .chains
-        .iter()
-        .map(|c| placed(vcs, diffs, review, c, shown))
-        .collect();
-    let newest = review.rounds.last().map_or(shown, |r| r.number);
-    let drafts = drafts
-        .iter()
-        .map(|d| {
