+fn review(title: &str, summary: &str, rounds: Vec<Round>) -> Review {
+    let mut h = header(Status::Waiting, None, &[]);
+    h.title = title.into();
+    Review {
+        header: h,
+        summary: summary.into(),
+        chains: Vec::new(),
+        rounds,
+    }
+}
