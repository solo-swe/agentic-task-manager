+                work.tasks().push(json!({"id": "T-1"}));
+                Ok(())
+            })
+            .unwrap();
+        assert!(
+            !store.paths().inbox().exists(),
+            "a change that didn't touch it writes none"
+        );
+        assert_eq!(
+            store.inbox(false).unwrap(),
+            atm_common::inbox::empty_inbox()
