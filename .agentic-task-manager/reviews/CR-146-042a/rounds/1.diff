diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 0b8c5c34..2ac1f562 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -139,9 +139,19 @@ jobs:
             target/aarch64-apple-darwin/release/atm target/x86_64-apple-darwin/release/atm
       # The app compiled as Tauri's bundler compiles it (both architectures, its features), with no secret in the
       # environment (ATM-661, audit A1): the signing step below then finds nothing left to build, and only bundles,
-      # signs and notarizes
+      # signs and notarizes. Until a pass compiles nothing (ATM-749): the first architecture's first compile writes the
+      # app's generated permissions (permissions/autogenerated, never committed) while its own build script runs, so
+      # its next compile finds them newer and compiles atm-app again; that second compile happens here, and the third
+      # pass must compile nothing
       - name: Compile the app, with no secrets
-        run: pnpm --dir dashboard run app:bundle --target universal-apple-darwin --no-bundle
+        run: |
+          set -o pipefail
+          for pass in 1 2 3; do
+            pnpm --dir dashboard run app:bundle --target universal-apple-darwin --no-bundle 2>&1 | tee "$RUNNER_TEMP/compile.log"
+            grep -q 'Compiling ' "$RUNNER_TEMP/compile.log" || exit 0
+          done
+          echo "::error::the app still compiles after three passes: the signing step would compile it with the secrets"
+          exit 1
       - name: Import the Developer ID certificate
         env:
           CERT_P12: ${{ secrets.DEVELOPER_ID_CERT_P12 }}
@@ -159,11 +169,18 @@ jobs:
           TAURI_SIGNING_PRIVATE_KEY: ${{ secrets.TAURI_SIGNING_PRIVATE_KEY }}
           TAURI_SIGNING_PRIVATE_KEY_PASSWORD: ${{ secrets.TAURI_SIGNING_PRIVATE_KEY_PASSWORD }}
         run: |
+          set -o pipefail
           printf '%s' "$NOTARY_KEY_P8" | base64 --decode > "$NOTARY_KEY"
           # Tauri's bundler signs every binary in the app (the bundled CLI too) and notarizes the app
           export APPLE_SIGNING_IDENTITY="$IDENTITY" APPLE_API_KEY="$NOTARY_KEY_ID" APPLE_API_ISSUER="$NOTARY_ISSUER"
           export APPLE_API_KEY_PATH="$NOTARY_KEY"
-          pnpm --dir dashboard run app:bundle --target universal-apple-darwin
+          pnpm --dir dashboard run app:bundle --target universal-apple-darwin 2>&1 | tee "$RUNNER_TEMP/bundle.log"
+          # Nothing compiles here (ATM-749): a compile with the secrets is a release to look into, not to publish
+          if grep -q 'Compiling ' "$RUNNER_TEMP/bundle.log"; then
+            rm "$NOTARY_KEY"
+            echo "::error::the signing step compiled code with the secrets in its environment"
+            exit 1
+          fi
           dmg=$(ls target/universal-apple-darwin/release/bundle/dmg/*.dmg)
           sh packaging/notarize-dmg.sh "$dmg"
           rm "$NOTARY_KEY"
diff --git a/dashboard/tests/unit/ci-workflow.test.ts b/dashboard/tests/unit/ci-workflow.test.ts
index 38828d6e..b9699e5e 100644
--- a/dashboard/tests/unit/ci-workflow.test.ts
+++ b/dashboard/tests/unit/ci-workflow.test.ts
@@ -178,11 +178,28 @@ describe('release workflows (I18, I19; T-452)', () => {
     const app = jobsOf(release).find((j) => j.startsWith('app-macos:'))!;
     const steps = stepsOf(app);
     const compile = steps.findIndex((s) => /app:bundle --target universal-apple-darwin --no-bundle/.test(s));
-    const sign = steps.findIndex((s) => /app:bundle --target universal-apple-darwin\n/.test(s));
+    const sign = steps.findIndex((s) => /app:bundle --target universal-apple-darwin 2>&1/.test(s));
     expect(compile).toBeGreaterThan(0);
     expect(steps[compile]).not.toMatch(/env:/);
     expect(sign).toBeGreaterThan(compile);
   });
+
+  // ATM-749: the first compile of a fresh checkout leaves atm-app dirty once (its generated permissions are newer
+  // than its build script's run), so one pass wasn't enough and the signing step compiled it with the secrets
+  it('the no-secrets step compiles until a pass compiles nothing, and the signing step fails if anything compiles', () => {
+    const app = jobsOf(release).find((j) => j.startsWith('app-macos:'))!;
+    const steps = stepsOf(app);
+    const compile = steps.find((s) => /--no-bundle/.test(s))!;
+    expect(compile).toMatch(/set -o pipefail/);
+    expect(compile).toMatch(/for pass in 1 2 3; do/);
+    expect(compile).toMatch(/--no-bundle 2>&1 \| tee "\$RUNNER_TEMP\/compile\.log"/);
+    expect(compile).toMatch(/grep -q 'Compiling ' "\$RUNNER_TEMP\/compile\.log" \|\| exit 0\n {10}done/);
+    expect(compile).toMatch(/exit 1$/m);
+    const sign = steps.find((s) => /secrets\.TAURI_SIGNING_PRIVATE_KEY/.test(s))!;
+    expect(sign).toMatch(/set -o pipefail/);
+    expect(sign).toMatch(/universal-apple-darwin 2>&1 \| tee "\$RUNNER_TEMP\/bundle\.log"/);
+    expect(sign).toMatch(/if grep -q 'Compiling ' "\$RUNNER_TEMP\/bundle\.log"; then\n(.*\n){0,3} {12}exit 1/);
+  });
 });
 
