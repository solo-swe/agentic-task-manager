index 00000000..4d174cfd
--- /dev/null
+++ b/crates/atm-lib/src/stats/intervals.rs
@@ -0,0 +1,132 @@
+//! Stretches of time, in milliseconds since 1970: their union, one less another, the gaps between them.
+
+/// A stretch of time, `[start, end)`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Interval {
+    pub start: i64,
+    pub end: i64,
+}
+
+impl Interval {
+    /// How long it is.
+    #[must_use]
+    pub fn length(self) -> i64 {
+        self.end - self.start
+    }
+}
+
+/// The union of `intervals`: sorted, disjoint, touching ones joined; empty ones left out.
+#[must_use]
+pub fn merge(intervals: &[Interval]) -> Vec<Interval> {
+    let mut sorted: Vec<Interval> = intervals
+        .iter()
+        .copied()
+        .filter(|i| i.end > i.start)
+        .collect();
+    sorted.sort_by_key(|i| i.start);
+    let mut out: Vec<Interval> = Vec::new();
+    for iv in sorted {
+        match out.last_mut() {
+            Some(last) if iv.start <= last.end => last.end = last.end.max(iv.end),
+            _ => out.push(iv),
+        }
+    }
+    out
+}
+
+/// `a` less `b`, both sorted and disjoint.
+#[must_use]
+pub fn subtract(a: &[Interval], b: &[Interval]) -> Vec<Interval> {
+    let mut out = Vec::new();
+    for iv in a {
+        let mut cursor = iv.start;
+        for cut in b {
+            if cut.end <= cursor || cut.start >= iv.end {
+                continue;
+            }
+            if cut.start > cursor {
+                out.push(Interval {
+                    start: cursor,
+                    end: cut.start,
+                });
+            }
+            cursor = cursor.max(cut.end);
+        }
+        if cursor < iv.end {
+            out.push(Interval {
+                start: cursor,
+                end: iv.end,
+            });
+        }
+    }
+    out
+}
+
+/// `intervals` cut to `[from, to]`, the empty ones left out.
+#[must_use]
+pub fn clip(intervals: &[Interval], from: i64, to: i64) -> Vec<Interval> {
+    intervals
+        .iter()
+        .map(|i| Interval {
+            start: i.start.max(from),
+            end: i.end.min(to),
+        })
+        .filter(|i| i.end > i.start)
+        .collect()
+}
+
+/// The time `intervals` cover within `[from, to]`.
+#[must_use]
+pub fn covered(intervals: &[Interval], from: i64, to: i64) -> i64 {
+    clip(intervals, from, to).iter().map(|i| i.length()).sum()
+}
+
+/// The gaps of at least `min` in the union of `intervals`, within `[from, to]`.
+#[must_use]
+pub fn gaps(intervals: &[Interval], from: i64, to: i64, min: i64) -> Vec<Interval> {
+    let mut out = Vec::new();
+    let mut cursor = from;
+    let mut sorted = intervals.to_vec();
+    sorted.sort_by_key(|i| i.start);
+    for iv in sorted {
+        if iv.end <= cursor {
+            continue;
+        }
+        if iv.start >= to {
+            break;
+        }
+        if iv.start - cursor >= min {
+            out.push(Interval {
+                start: cursor,
+                end: iv.start,
+            });
+        }
+        cursor = cursor.max(iv.end);
+        if cursor >= to {
+            break;
+        }
+    }
+    if to - cursor >= min {
+        out.push(Interval {
+            start: cursor,
+            end: to,
+        });
+    }
+    out
+}
+
+/// The middle value of `values` (the mean of the middle two for an even count), none without values.
+#[must_use]
+pub fn median(values: &[f64]) -> Option<f64> {
+    if values.is_empty() {
+        return None;
+    }
+    let mut sorted = values.to_vec();
+    sorted.sort_by(f64::total_cmp);
+    let mid = sorted.len() / 2;
+    Some(if sorted.len() % 2 == 1 {
+        sorted[mid]
+    } else {
+        f64::midpoint(sorted[mid - 1], sorted[mid])
+    })
+}
diff --git a/crates/atm-lib/src/stats/people.rs b/crates/atm-lib/src/stats/people.rs
new file mode 100644
index 00000000..1dc4df83
--- /dev/null
+++ b/crates/atm-lib/src/stats/people.rs
@@ -0,0 +1,85 @@
+//! Who worked on the project (docs/project-stats-proposal.md §3, T-252): the people, with the tasks they created,
+//! started and completed, most active first; and the agents in one summary. Tasks from before atm recorded who started
+//! them count as agent work, as on the Agents tab.
+
+use std::collections::{BTreeMap, HashSet};
+
+use atm_common::Kind;
+use atm_common::edits::is_agent;
+use serde_json::{Value, json};
+
+use super::Item;
+use super::time::time_use;
+
+#[derive(Default)]
+struct Person {
+    created: usize,
+    started: usize,
+    completed: usize,
+}
+
+/// `{people: [{name, created, started, completed}], agents: {sessions, started, completed, agent_ms}}`.
+pub(super) fn actors(items: &[&Item], now: i64) -> Value {
+    let mut people: BTreeMap<String, Person> = BTreeMap::new();
+    let mut sessions: HashSet<String> = HashSet::new();
+    let (mut by_agents, mut completed) = (0usize, 0usize);
+    let mut agent_work: Vec<&Item> = Vec::new();
+    let text = |item: &Item, field: &str| {
+        item.task
+            .get(field)
+            .and_then(Value::as_str)
+            .map(String::from)
+    };
+    for item in items {
+        let starter = item.started_by().map(String::from);
+        let created_by = text(item, "created_by");
+        let completed_by = text(item, "completed_by");
+        if let Some(by) = created_by.as_ref().filter(|b| !is_agent(Some(b))) {
+            people.entry(by.clone()).or_default().created += 1;
+        }
+        let agent_started = match &starter {
+            Some(by) if !is_agent(Some(by)) => {
+                people.entry(by.clone()).or_default().started += 1;
+                false
+            }
+            Some(by) => {
+                sessions.insert(by.clone());
+                true
+            }
+            None => item.time("started_at").is_some(),
+        };
+        if agent_started {
+            by_agents += 1;
+            agent_work.push(item);
+        }
+        // Before v4 nobody recorded who completed a task: a finished task an agent started counts as the agent's
+        match &completed_by {
+            Some(by) if !is_agent(Some(by)) => people.entry(by.clone()).or_default().completed += 1,
+            Some(by) => {
+                completed += 1;
+                sessions.insert(by.clone());
+            }
+            None if agent_started && item.kind == Some(Kind::Done) => completed += 1,
+            None => {}
+        }
+        if let Some(by) = created_by.filter(|b| is_agent(Some(b))) {
+            sessions.insert(by);
+        }
+    }
+    let mut listed: Vec<(String, Person)> = people.into_iter().collect();
+    listed.sort_by(|a, b| {
+        let total = |p: &Person| p.created + p.started + p.completed;
+        total(&b.1).cmp(&total(&a.1)).then_with(|| a.0.cmp(&b.0))
+    });
+    json!({
+        "people": listed.into_iter().map(|(name, p)| json!({
+            "name": name, "created": p.created, "started": p.started, "completed": p.completed,
+        })).collect::<Vec<_>>(),
+        "agents": {
+            "sessions": sessions.len(),
+            "started": by_agents,
+            "completed": completed,
+            "agent_ms": time_use(&agent_work, None, now).map_or(0, |u| u.agent_ms),
+        },
+    })
+}
diff --git a/crates/atm-lib/src/stats/progress.rs b/crates/atm-lib/src/stats/progress.rs
new file mode 100644
index 00000000..dda6fd02
--- /dev/null
+++ b/crates/atm-lib/src/stats/progress.rs
@@ -0,0 +1,99 @@
+//! How far along the tasks are: overall, by status, by type and by sprint. Archived tasks count as what they are (an
+//! archived skipped task is skipped, not done: the dashboard's old count took every archived task for done).
+
+use std::collections::BTreeMap;
+
+use atm_common::{Kind, Vocabulary};
+use serde_json::{Value, json};
+
+use super::Item;
+
+/// The status split's order: by kind, finished first; statuses without a kind last.
+const KIND_ORDER: [Kind; 6] = [
+    Kind::Done,
+    Kind::Active,
+    Kind::Review,
+    Kind::Todo,
+    Kind::Blocked,
+    Kind::Skipped,
+];
+
+/// A group's completion, as atm counts it: done of all but the skipped; a group of only skipped tasks is finished.
+fn share(key: &Value, label: &str, items: &[&Item]) -> Value {
+    let done = items.iter().filter(|i| i.kind == Some(Kind::Done)).count();
+    let skipped = items
+        .iter()
+        .filter(|i| i.kind == Some(Kind::Skipped))
+        .count();
+    let total = items.len() - skipped;
+    #[allow(clippy::cast_precision_loss)] // reason: counts of tasks
+    let ratio = if total > 0 {
+        done as f64 / total as f64
+    } else if skipped > 0 {
+        1.0
+    } else {
+        0.0
+    };
+    json!({"key": key, "label": label, "done": done, "total": total, "skipped": skipped, "ratio": ratio})
+}
+
+/// `{overall, archived, by_status: [{status, count}], by_type: [share], by_sprint: [share]}`: the sprints in the
+/// project's order, then the backlog (`key` null), each only with tasks.
+pub(super) fn progress(items: &[&Item], vocab: &Vocabulary) -> Value {
+    let archived = items.iter().filter(|i| i.archived).count();
+    let mut by_status: BTreeMap<String, usize> = BTreeMap::new();
+    let mut by_type: BTreeMap<String, Vec<&Item>> = BTreeMap::new();
+    for item in items {
+        let status = item
+            .task
+            .get("status")
+            .and_then(Value::as_str)
+            .unwrap_or_default();
+        *by_status.entry(status.to_string()).or_default() += 1;
+        let kind = item
+            .task
+            .get("type")
+            .and_then(Value::as_str)
+            .unwrap_or_default();
+        by_type.entry(kind.to_string()).or_default().push(item);
+    }
+    let rank = |status: &str| {
+        vocab
+            .kind_of(Some(&json!(status)))
+            .and_then(|k| KIND_ORDER.iter().position(|o| *o == k))
+            .unwrap_or(KIND_ORDER.len())
+    };
+    let mut statuses: Vec<(String, usize)> = by_status.into_iter().collect();
+    statuses.sort_by(|a, b| rank(&a.0).cmp(&rank(&b.0)).then_with(|| a.0.cmp(&b.0)));
+    let sprint_ids: Vec<String> = vocab
+        .sprints
+        .iter()
+        .filter_map(|s| s.get("id").and_then(Value::as_str).map(String::from))
+        .collect();
+    let mut by_sprint: Vec<Value> = sprint_ids
+        .iter()
+        .filter_map(|id| {
+            let own: Vec<&Item> = items
+                .iter()
+                .copied()
+                .filter(|i| i.sprint.as_deref() == Some(id.as_str()))
+                .collect();
+            (!own.is_empty()).then(|| share(&json!(id), id, &own))
+        })
+        .collect();
+    let backlog: Vec<&Item> = items
+        .iter()
+        .copied()
+        .filter(|i| i.sprint.as_ref().is_none_or(|s| !sprint_ids.contains(s)))
+        .collect();
+    if !backlog.is_empty() {
+        by_sprint.push(share(&Value::Null, "Backlog", &backlog));
+    }
+    json!({
+        "overall": share(&json!("all"), "All tasks", items),
+        "archived": archived,
+        "by_status": statuses.into_iter().map(|(status, count)| json!({"status": status, "count": count})).collect::<Vec<_>>(),
+        "by_type": by_type.iter().map(|(t, own)| share(&json!(t), t, own)).collect::<Vec<_>>(),
+        "by_sprint": by_sprint,
+    })
+}
diff --git a/crates/atm-lib/src/stats/tests.rs b/crates/atm-lib/src/stats/tests.rs
new file mode 100644
index 00000000..3cad5cbc
--- /dev/null
+++ b/crates/atm-lib/src/stats/tests.rs
@@ -0,0 +1,446 @@
+use std::collections::BTreeSet;
+
+use atm_db::MemoryStore;
+use serde_json::{Value, json};
+
+use super::*;
+
+/// 2026-11-01T00:00:00Z in ms, and n minutes after it as ISO text
+const T0: i64 = 1_793_491_200_000;
+fn at(minutes: i64) -> String {
+    atm_common::time::format_iso((T0 + minutes * 60_000) / 1000)
+}
+
+fn task(v: &Value) -> atm_common::Task {
+    v.as_object().unwrap().clone()
+}
+
+fn project(meta: &Value, tasks: &[Value], archive: &[Value]) -> Project {
+    Project::new(Box::new(
+        MemoryStore::new(
+            tasks.iter().map(task).collect(),
+            archive.iter().map(task).collect(),
+            meta.as_object().unwrap(),
+        )
+        .unwrap(),
+    ))
+}
+
+/// A done task with `minutes` of work, finished at minute `end`, by `by`
+fn done(id: &str, end: i64, minutes: i64, by: &str) -> Value {
+    json!({"id": id, "name": id, "type": "feature", "status": "done", "started_by": by,
+           "started_at": at(end - minutes), "completed_at": at(end), "completed_by": by})
+}
+
+fn stats(p: &Project, query: &StatsQuery, now_minutes: i64) -> Value {
+    project_stats(p, query, T0 + now_minutes * 60_000).unwrap()
+}
+
+const SPRINTS: &str = r#"{"sprints": [
+    {"id": "Old", "state": "closed"},
+    {"id": "Later", "state": "planned"},
+    {"id": "Now", "state": "active"}
+]}"#;
+
+/// The overview's Progress tab from the summary: done of all but the skipped (the archive too), the open releases,
+/// the days with completions, a daily burndown and the work left at the agents' pace
+#[test]
+fn the_overview_figures_count_the_archive_and_give_a_daily_burndown_and_the_work_left() {
+    let day = T0 / 86_400_000;
+    let meta = json!({"releases": [{"id": "1.0", "state": "planned"}, {"id": "0.9", "state": "released"}]});
+    let mut tasks = vec![
+        json!({"id": "T-1", "name": "1", "type": "x", "status": "todo", "release": "1.0", "created_at": at(0)}),
+        json!({"id": "T-2", "name": "2", "type": "x", "status": "blocked", "waiting_on": "user", "created_at": at(0)}),
+        json!({"id": "T-3", "name": "3", "type": "x", "status": "skipped", "created_at": at(0)}),
+    ];
+    for (id, end) in [("D-1", 60), ("D-2", 1500), ("D-3", 1600)] {
+        let mut d = done(id, end, 10, "claude:a");
+        d["created_at"] = json!(at(0));
+        tasks.push(d);
+    }
+    let mut archived = done("A-1", 30, 10, "claude:a");
+    archived["created_at"] = json!(at(0));
+    let p = project(&meta, &tasks, &[archived]);
+    let o = overview(&p, T0 + 1700 * 60_000).unwrap();
+    assert_eq!(
+        (o["done"].clone(), o["total"].clone()),
+        (json!(4), json!(6))
+    );
+    assert_eq!(
+        o["open_releases"],
+        json!([{"id": "1.0", "name": null, "done": 0, "total": 1}])
+    );
+    // A-1 and D-1 on the first day, D-2 and D-3 on the second (minutes 1500 and 1600)
+    assert_eq!(o["done_days"], json!([[day, 2], [day + 1, 2]]));
+    assert_eq!(o["burndown"], json!([[day, 6, 4], [day + 1, 6, 2]]));
+    // T-1 is agent work left (10 minutes each at this pace); T-2 waits on the user
+    assert_eq!(
+        o["forecast"],
+        json!({"minutes": {"likely": 10.0, "low": 10.0, "high": 10.0}, "waiting": 1})
+    );
+    // No pace yet: no forecast
+    let new = project(
+        &json!({}),
+        &[json!({"id": "T-1", "name": "1", "type": "x", "status": "todo"})],
+        &[],
+    );
+    let fresh = overview(&new, T0).unwrap();
+    assert_eq!(fresh["forecast"], Value::Null);
+    assert_eq!(
+        fresh["burndown"],
+        json!([]),
+        "no task with a time: nothing to draw"
+    );
+}
+
+/// Who worked on it (T-252, the dashboard's cases): people by what they created, started and completed; agents by
+/// session, a task from before v4 (`agent`) or with nobody recorded counting as agent work
+#[test]
+fn people_and_agents_count_what_each_did_older_files_too() {
+    let tasks = vec![
+        json!({"id": "T-1", "name": "1", "type": "x", "status": "done", "created_by": "Hakan",
+               "started_by": "claude:a", "started_at": at(0), "completed_by": "claude:a", "completed_at": at(30)}),
+        json!({"id": "T-2", "name": "2", "type": "x", "status": "done", "created_by": "Hakan",
+               "started_by": "claude:b", "started_at": at(10), "completed_by": "Hakan", "completed_at": at(60)}),
+        json!({"id": "T-3", "name": "3", "type": "x", "status": "in_progress", "created_by": "Hakan",
+               "agent": "claude:c", "started_at": at(60)}),
+        json!({"id": "T-4", "name": "4", "type": "x", "status": "done", "created_by": "Hakan",
+               "started_at": at(100), "completed_at": at(110)}),
+        json!({"id": "T-5", "name": "5", "type": "x", "status": "in_progress", "created_by": "claude:a",
+               "started_by": "Ana", "started_at": at(0)}),
+    ];
+    let p = project(&json!({}), &tasks, &[]);
+    let actors = &stats(&p, &StatsQuery::default(), 120)["actors"];
+    assert_eq!(
+        actors["people"],
+        json!([
+            {"name": "Hakan", "created": 4, "started": 0, "completed": 1},
+            {"name": "Ana", "created": 0, "started": 1, "completed": 0}
+        ])
+    );
+    // Sessions a, b, c; T-4 (nobody recorded) is agent work with no session. Completed: T-1 by a, T-4 finished with
+    // no completed_by; T-2 was Hakan's
+    assert_eq!(actors["agents"]["sessions"], json!(3));
+    assert_eq!(
+        (
+            actors["agents"]["started"].clone(),
+            actors["agents"]["completed"].clone()
+        ),
+        (json!(4), json!(2))
+    );
+    // T-1 30 m, T-2 50 m, T-3 60 m (to now), T-4 10 m; Ana's T-5 isn't agent time
+    assert_eq!(actors["agents"]["agent_ms"], json!(150 * 60_000));
+    // No tasks: nobody, and no agent time
+    let empty = project(&json!({}), &[], &[]);
+    assert_eq!(
+        stats(&empty, &StatsQuery::default(), 0)["actors"],
+        json!({"people": [], "agents": {"sessions": 0, "started": 0, "completed": 0, "agent_ms": 0}})
+    );
+}
+
+#[test]
+fn the_pace_is_the_middle_of_the_last_ten_with_quartiles_and_none_under_three() {
+    assert_eq!(forecast::pace(&[10.0, 20.0]), None);
+    let p = forecast::pace(&[10.0, 20.0, 30.0, 40.0]).unwrap();
+    assert!((p.likely - 25.0).abs() < 1e-9, "{p:?}");
+    assert!((p.low - 17.5).abs() < 1e-9, "{p:?}");
+    assert!((p.high - 32.5).abs() < 1e-9, "{p:?}");
+    assert_eq!(p.based_on, 4);
+    // Only the last ten count
+    let many: Vec<f64> = (1..=12).map(f64::from).collect();
+    assert_eq!(forecast::pace(&many).unwrap().based_on, 10);
+}
+
+/// The rows in the loop's order (closed, active, planned, backlog), the work left accumulating from the active sprint
+/// on; the pace leaves the tasks done with the user out
+#[test]
+fn the_forecast_counts_each_sprint_and_estimates_in_the_loops_order() {
+    let meta: Value = serde_json::from_str(SPRINTS).unwrap();
+    let mut tasks = vec![
+        json!({"id": "T-1", "name": "1", "type": "feature", "status": "todo", "sprint": "Now"}),
+        json!({"id": "T-2", "name": "2", "type": "feature", "status": "todo", "sprint": "Later"}),
+        json!({"id": "T-3", "name": "3", "type": "feature", "status": "todo"}),
+        json!({"id": "T-4", "name": "4", "type": "feature", "status": "blocked", "sprint": "Now", "waiting_on": "user"}),
+        json!({"id": "T-5", "name": "5", "type": "feature", "status": "skipped", "sprint": "Now"}),
+    ];
+    // The pace: three tasks of 10, 20 and 30 minutes, and one with the user of 600 (left out)
+    for (id, end, minutes) in [("D-1", 100, 10), ("D-2", 200, 20), ("D-3", 300, 30)] {
+        let mut d = done(id, end, minutes, "claude:a");
+        d["sprint"] = json!("Old");
+        tasks.push(d);
+    }
+    let mut together = done("D-4", 1000, 600, "claude:a");
+    together["with"] = json!("user");
+    together["sprint"] = json!("Old");
+    tasks.push(together);
+    let p = project(&meta, &tasks, &[]);
+    let f = &stats(&p, &StatsQuery::default(), 2000)["forecast"];
+    assert_eq!(
+        f["pace"]["likely"],
+        json!(20.0),
+        "the with-user task is left out"
+    );
+    let rows: Vec<(Value, Value, Value, Value)> = f["sprints"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|r| {
+            (
+                r["sprint"].clone(),
+                r["total"].clone(),
+                r["remaining"].clone(),
+                r["state"].clone(),
+            )
+        })
+        .collect();
+    assert_eq!(
+        rows,
+        [
+            (json!("Old"), json!(4), json!(0), json!("done")),
+            (json!("Now"), json!(2), json!(1), json!("not_started")),
+            (json!("Later"), json!(1), json!(1), json!("not_started")),
+            (Value::Null, json!(1), json!(1), json!("not_started")),
+        ]
+    );
+    let sprints = f["sprints"].as_array().unwrap();
+    let likely = |n: usize| sprints[n]["estimate"]["minutes"]["likely"].clone();
+    // Done: none; then 1, 2 and 3 tasks' work at 20 minutes each, in the loop's order
+    assert_eq!(sprints[0].get("estimate"), None);
+    assert_eq!(
+        (likely(1), likely(2), likely(3)),
+        (json!(20.0), json!(40.0), json!(60.0))
+    );
+    assert_eq!(sprints[0]["completed_at"], json!(T0 + 1000 * 60_000));
+    assert_eq!(sprints[1]["blocked"], json!(1));
+    assert_eq!(sprints[1]["skipped"], json!(1));
+    // The loop works on the active sprint next
+    assert_eq!(f["next"], json!({"sprint": "Now"}));
+}
+
+/// A slice keeps its own counts, with the whole project's estimates (the loop works through whole sprints)
+#[test]
+fn a_slice_counts_its_own_tasks_with_the_whole_projects_estimates() {
+    let meta: Value = serde_json::from_str(SPRINTS).unwrap();
+    let mut tasks = vec![
+        json!({"id": "T-1", "name": "1", "type": "bugfix", "status": "todo", "sprint": "Now"}),
+        json!({"id": "T-2", "name": "2", "type": "feature", "status": "todo", "sprint": "Now"}),
+    ];
+    for (id, end) in [("D-1", 100), ("D-2", 200), ("D-3", 300)] {
+        tasks.push(done(id, end, 10, "claude:a"));
+    }
+    let p = project(&meta, &tasks, &[]);
+    let query = StatsQuery {
+        tasks: Some(BTreeSet::from(["T-1".to_string()])),
+        ..StatsQuery::default()
+    };
+    let s = stats(&p, &query, 2000);
+    let now = &s["forecast"]["sprints"][0];
+    assert_eq!(
+        (now["sprint"].clone(), now["total"].clone()),
+        (json!("Now"), json!(1))
+    );
+    // Two tasks left in the whole sprint: 20 minutes, not the slice's one
+    assert_eq!(now["estimate"]["minutes"]["likely"], json!(20.0));
+    assert_eq!(s["progress"]["overall"]["total"], json!(1));
+    // The project's own numbers stay the whole project's
+    assert_eq!(s["stats"]["tasks"]["total"], json!(5));
+}
+
+/// Archived tasks count as what they are: an archived skipped task is skipped, not done (the dashboard's old count)
+#[test]
+fn progress_counts_archived_tasks_as_they_are_by_status_type_and_sprint() {
+    let meta: Value = serde_json::from_str(SPRINTS).unwrap();
+    let tasks = vec![
+        json!({"id": "T-1", "name": "1", "type": "bugfix", "status": "todo", "sprint": "Now"}),
+        json!({"id": "T-2", "name": "2", "type": "feature", "status": "in_progress"}),
+        json!({"id": "T-3", "name": "3", "type": "feature", "status": "made_up"}),
+    ];
+    let archive = vec![
+        done("A-1", 10, 5, "claude:a"),
+        json!({"id": "A-2", "name": "2", "type": "feature", "status": "skipped", "sprint": "Old"}),
+    ];
+    let p = project(&meta, &tasks, &archive);
+    let progress = &stats(&p, &StatsQuery::default(), 100)["progress"];
+    assert_eq!(
+        progress["overall"],
+        json!({"key": "all", "label": "All tasks", "done": 1, "total": 4, "skipped": 1, "ratio": 0.25})
+    );
+    assert_eq!(progress["archived"], json!(2));
+    // By kind, finished first; a status the vocabulary lacks last
+    let statuses: Vec<Value> = progress["by_status"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|s| s["status"].clone())
+        .collect();
+    assert_eq!(
+        statuses,
+        [
+            json!("done"),
+            json!("in_progress"),
+            json!("todo"),
+            json!("skipped"),
+            json!("made_up")
+        ]
+    );
+    let types: Vec<Value> = progress["by_type"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|t| t["key"].clone())
+        .collect();
+    assert_eq!(types, [json!("bugfix"), json!("feature")]);
+    // The sprints in the project's order, then the backlog; a closed sprint of only skipped tasks is finished
+    let sprints: Vec<(Value, Value)> = progress["by_sprint"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|s| (s["key"].clone(), s["ratio"].clone()))
+        .collect();
+    assert_eq!(
+        sprints,
+        [
+            (json!("Old"), json!(1.0)),
+            (json!("Now"), json!(0.0)),
+            (Value::Null, json!(1.0 / 3.0))
+        ]
+    );
+}
+
+/// A project not migrated to sprints: its phases are the sprints `atm db migrate` would make, as the sprint views count
+/// them, in the forecast and the progress alike
+#[test]
+fn an_unmigrated_projects_phases_are_its_sprints() {
+    let mut first = done("T-1", 10, 5, "claude:a");
+    first["phase"] = json!(0);
+    let tasks = vec![
+        first,
+        json!({"id": "T-2", "name": "2", "type": "feature", "status": "todo", "phase": 1}),
+        json!({"id": "T-3", "name": "3", "type": "feature", "status": "todo"}),
+    ];
+    let p = project(&json!({}), &tasks, &[]);
+    let s = stats(&p, &StatsQuery::default(), 100);
+    let rows: Vec<Value> = s["forecast"]["sprints"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|r| r["sprint"].clone())
+        .collect();
+    assert_eq!(rows, [json!("Phase 0"), json!("Phase 1"), Value::Null]);
+    let by_sprint: Vec<Value> = s["progress"]["by_sprint"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|r| r["key"].clone())
+        .collect();
+    assert_eq!(by_sprint, [json!("Phase 0"), json!("Phase 1"), Value::Null]);
+}
+
+#[test]
+fn time_is_split_into_working_waiting_on_you_and_idle_and_parallel_agents_add_up() {
+    // Two agents at once for 30 minutes (0–30, 10–40), a review on the user from 40 to 60, then idle to 120
+    let tasks = vec![
+        done("D-1", 30, 30, "claude:a"),
+        done("D-2", 40, 30, "claude:b"),
+        json!({"id": "R-1", "name": "r", "type": "feature", "status": "done", "started_by": "claude:a",
+               "started_at": at(40), "review_requested_at": at(40), "completed_at": at(60),
+               "reviews": [{"from": at(40), "to": at(60)}]}),
+    ];
+    let p = project(&json!({}), &tasks, &[]);
+    let s = stats(&p, &StatsQuery::default(), 120);
+    let u = &s["time_use"];
+    assert_eq!(u["from"], json!(T0));
+    assert_eq!(u["working_ms"], json!(40 * 60_000));
+    assert_eq!(u["waiting_ms"], json!(20 * 60_000));
+    assert_eq!(u["idle_ms"], json!(60 * 60_000));
+    assert_eq!(u["agent_ms"], json!(60 * 60_000));
+    assert_eq!(u["max_agents"], json!(2));
+    // A period inside it: cut to it
+    let period = StatsQuery {
+        from: Some(T0 + 20 * 60_000),
+        to: Some(T0 + 30 * 60_000),
+        ..StatsQuery::default()
+    };
+    let cut = &stats(&p, &period, 120)["time_use"];
+    assert_eq!(
+        (cut["working_ms"].clone(), cut["agent_ms"].clone()),
+        (json!(600_000), json!(1_200_000))
+    );
+    // No work at all: none
+    let empty = project(
+        &json!({}),
+        &[json!({"id": "T-1", "name": "1", "type": "x", "status": "todo"})],
+        &[],
+    );
+    assert_eq!(
+        stats(&empty, &StatsQuery::default(), 10)["time_use"],
+        Value::Null
+    );
+}
+
+#[test]
+fn the_projects_numbers_people_and_agents_and_the_time_per_task() {
+    let mut with_you = done("D-2", 200, 90, "claude:b");
+    with_you["with"] = json!("user");
+    with_you["pr"] = json!({"number": 7});
+    with_you["commit"] = json!("abc");
+    let tasks = vec![
+        done("D-1", 100, 3, "claude:a"),
+        with_you,
+        json!({"id": "T-1", "name": "1", "type": "feature", "status": "todo", "created_by": "Hakan Serce",
+               "created_at": at(-60)}),
+        done("D-3", 300, 300, "Hakan Serce"),
+    ];
+    let p = project(&json!({"workflow": {"type": "direct"}}), &tasks, &[]);
+    let s = stats(&p, &StatsQuery::default(), 400);
+    let numbers = &s["stats"];
+    assert_eq!(numbers["started"], json!(T0 - 60 * 60_000));
+    assert_eq!(numbers["duration"]["ongoing"], json!(true));
+    assert_eq!(
+        numbers["tasks"],
+        json!({"total": 4, "done": 3, "open": 1, "skipped": 0})
+    );
+    assert_eq!(
+        (
+            numbers["task_commits"].clone(),
+            numbers["pull_requests"].clone()
+        ),
+        (json!(1), json!(1))
+    );
+    // Agents' time: a's 3 minutes alone, b's 90 with you; the person's isn't the agents'
+    assert_eq!(numbers["agent_ms"], json!(93 * 60_000));
+    assert_eq!(numbers["alone_ms"], json!(3 * 60_000));
+    assert_eq!(numbers["with_you_ms"], json!(90 * 60_000));
+    let actors = &s["actors"];
+    assert_eq!(
+        actors["people"],
+        json!([{"name": "Hakan Serce", "created": 1, "started": 1, "completed": 1}])
+    );
+    assert_eq!(actors["agents"]["sessions"], json!(2));
+    assert_eq!(actors["agents"]["completed"], json!(2));
+    // The time per task: 3 m in the first bin, 90 m with you, 300 m in the last (4 h+)
+    let h = &s["histogram"];
+    let in_bin = |n: usize, side: &str| h["bins"][n][side].as_array().unwrap().len();
+    assert_eq!(
+        (
+            in_bin(0, "alone"),
+            in_bin(7, "with_you"),
+            in_bin(10, "alone")
+        ),
+        (1, 1, 1)
+    );
+    assert_eq!(h["bins"][10]["label"], json!("4 h+"));
+    assert_eq!(h["bins"][0]["label"], json!("0 m–5 m"));
+    assert_eq!(h["slowest"][0]["id"], json!("D-3"));
+    assert_eq!(h["median_with_you"], json!(90.0));
+    // A direct project with no PR recorded has none to count
+    let plain = project(
+        &json!({"workflow": {"type": "direct"}}),
+        &[done("D-1", 10, 5, "claude:a")],
+        &[],
+    );
+    assert_eq!(
+        stats(&plain, &StatsQuery::default(), 20)["stats"]["pull_requests"],
+        Value::Null
+    );
+}
diff --git a/crates/atm-lib/src/stats/time.rs b/crates/atm-lib/src/stats/time.rs
new file mode 100644
index 00000000..ded9643f
--- /dev/null
+++ b/crates/atm-lib/src/stats/time.rs
@@ -0,0 +1,334 @@
+//! Where the time went (docs/activity-popup-review.md §3.1, §5), the project's numbers (docs/project-stats-proposal.md
+//! §4) and the time per task. Work is atm's ([`crate::work`]); agent time adds up parallel agents, each agent's
+//! overlapping stretches merged first.
+
+use std::collections::HashMap;
+
+use atm_common::edits::is_agent;
+use atm_common::{Kind, Vocabulary};
+use serde_json::{Value, json};
+
+use super::Item;
+use super::intervals::{Interval, clip, covered, gaps, median, merge, subtract};
+
+/// Shorter pauses (an agent picking up the next task) aren't idle.
+pub const MIN_IDLE_MS: i64 = 10 * 60_000;
+
+/// Time split three ways from the first work on: agents working (at least one at work, and the short pauses between
+/// tasks), waiting on you (no agent working while a task is in review or blocked on the user), idle (the rest, in
+/// stretches of at least [`MIN_IDLE_MS`]).
+#[derive(Debug, Clone, PartialEq)]
+pub struct TimeUse {
+    pub from: i64,
+    pub to: i64,
+    pub working_ms: i64,
+    pub waiting_ms: i64,
+    pub idle_ms: i64,
+    /// Work time with parallel agents added up.
+    pub agent_ms: i64,
+    /// The most agents working at the same moment.
+    pub max_agents: usize,
+    pub waiting: Vec<Interval>,
+    pub idle: Vec<Interval>,
+}
+
+impl TimeUse {
+    /// As the stats route gives it; `waiting` and `idle` as `[start, end]` pairs, for a chart's buckets.
+    #[must_use]
+    pub fn to_json(&self) -> Value {
+        let pairs = |list: &[Interval]| {
+            list.iter()
+                .map(|i| json!([i.start, i.end]))
+                .collect::<Vec<_>>()
+        };
+        json!({
+            "from": self.from, "to": self.to,
+            "working_ms": self.working_ms, "waiting_ms": self.waiting_ms, "idle_ms": self.idle_ms,
+            "agent_ms": self.agent_ms, "max_agents": self.max_agents,
+            "waiting": pairs(&self.waiting), "idle": pairs(&self.idle),
+        })
+    }
+}
+
+/// When the task waited on you: each review round (`reviews`; the one now while atm says it waits on its reviewer or
+/// you) and each block on the user (`blocks`; the one now); a done task's review from files before `reviews`.
+fn waiting_intervals(item: &Item, now: i64) -> Vec<Interval> {
+    let mut out = Vec::new();
+    let mut add = |from: Option<i64>, to: Option<i64>| {
+        if let (Some(start), Some(end)) = (from, to)
+            && end > start
+        {
+            out.push(Interval { start, end });
+        }
+    };
+    let ms = |v: Option<&Value>| {
+        v.and_then(Value::as_str)
+            .and_then(atm_common::time::parse_iso)
+            .map(|s| s * 1000)
+    };
+    let list = |field: &str| {
+        item.task
+            .get(field)
+            .and_then(Value::as_array)
+            .cloned()
+            .unwrap_or_default()
+    };
+    let reviews = list("reviews");
+    for r in &reviews {
+        add(ms(r.get("from")), ms(r.get("to")));
+    }
+    for b in list("blocks") {
+        if b.get("on").and_then(Value::as_str) == Some("user") {
+            add(ms(b.get("from")), ms(b.get("to")));
+        }
+    }
+    let requested = item.task.get("review_requested_at");
+    let recorded = reviews.iter().any(|r| r.get("from") == requested);
+    let on_you = matches!(item.waiting_on.as_deref(), Some("reviewer" | "user"));
+    match item.kind {
+        Some(Kind::Review) if on_you => add(ms(requested), Some(now)),
+        Some(Kind::Done) if !recorded => add(ms(requested), item.time("completed_at")),
+        Some(Kind::Blocked)
+            if item.task.get("waiting_on").and_then(Value::as_str) == Some("user") =>
+        {
+            add(item.time("blocked_at"), Some(now));
+        }
+        _ => {}
+    }
+    out
+}
+
+/// The work of `items` as (who did it, the stretch): the stretch's own `by`, else who started the task, else nobody.
+fn work_of(items: &[&Item]) -> Vec<(String, Interval)> {
+    items
+        .iter()
+        .flat_map(|item| {
+            item.spans
+                .iter()
+                .filter(|s| s.1 > s.0)
+                .map(move |(start, end, by)| {
+                    let who = by
+                        .clone()
+                        .or_else(|| item.started_by().map(String::from))
+                        .unwrap_or_default();
+                    (
+                        who,
+                        Interval {
+                            start: *start,
+                            end: *end,
+                        },
+                    )
+                })
+        })
+        .collect()
+}
+
+/// Each agent's stretches merged (an agent on two tasks counts once; a stretch with nobody is its own), and the most at
+/// once.
+fn agents_at_work(work: &[(String, Interval)]) -> (Vec<Interval>, usize) {
+    let mut per_agent: HashMap<String, Vec<Interval>> = HashMap::new();
+    for (n, (who, iv)) in work.iter().enumerate() {
+        let key = if who.is_empty() {
+            format!("\u{0}{n}")
+        } else {
+            who.clone()
+        };
+        per_agent.entry(key).or_default().push(*iv);
+    }
+    let spans: Vec<Interval> = per_agent.values().flat_map(|l| merge(l)).collect();
+    let mut edges: Vec<(i64, i32)> = spans
+        .iter()
+        .flat_map(|s| [(s.start, 1), (s.end, -1)])
+        .collect();
+    edges.sort_unstable();
+    let (mut current, mut most) = (0i32, 0i32);
+    for (_, d) in edges {
+        current += d;
+        most = most.max(current);
+    }
+    (spans, usize::try_from(most).unwrap_or(0))
+}
+
+/// Where the time went in `period` (none: from the first work to now), or none when no work falls in it.
+#[must_use]
+pub(super) fn time_use(items: &[&Item], period: Option<Interval>, now: i64) -> Option<TimeUse> {
+    let work = work_of(items);
+    let first = work.iter().map(|(_, iv)| iv.start).min()?;
+    let from = period.map_or(first, |p| p.start.max(first));
+    let to = period.map_or(now, |p| p.end.min(now));
+    if to <= from {
+        return None;
+    }
+    let stretches: Vec<Interval> = work.iter().map(|(_, iv)| *iv).collect();
+    let working = merge(&clip(&stretches, from, to));
+    if working.is_empty() {
+        return None;
+    }
+    let all_waiting: Vec<Interval> = items
+        .iter()
+        .flat_map(|i| waiting_intervals(i, now))
+        .collect();
+    let waiting = subtract(&merge(&clip(&merge(&all_waiting), from, to)), &working);
+    let busy = merge(&[working.clone(), waiting.clone()].concat());
+    let idle = gaps(&busy, from, to, MIN_IDLE_MS);
+    let clipped: Vec<(String, Interval)> = work
+        .iter()
+        .flat_map(|(who, iv)| {
+            clip(&[*iv], from, to)
+                .into_iter()
+                .map(move |c| (who.clone(), c))
+        })
+        .collect();
+    let (agent_spans, max_agents) = agents_at_work(&clipped);
+    let waiting_ms = covered(&waiting, from, to);
+    let idle_ms = covered(&idle, from, to);
+    Some(TimeUse {
+        from,
+        to,
+        working_ms: (to - from - waiting_ms - idle_ms).max(0),
+        waiting_ms,
+        idle_ms,
+        agent_ms: agent_spans.iter().map(|s| s.length()).sum(),
+        max_agents,
+        waiting,
+        idle,
+    })
+}
+
+/// Tasks an agent started, or nobody recorded (before v4): agent work, as the Information's Agents line counts it.
+fn agent_tasks<'a>(items: &[&'a Item]) -> Vec<&'a Item> {
+    items
+        .iter()
+        .copied()
+        .filter(|i| i.started_by().is_none_or(|by| is_agent(Some(by))))
+        .collect()
+}
+
+/// The project's numbers over its whole history (T-253): when it started, how long it ran, its tasks, sprints, commits
+/// and pull requests, and its agents' time, alone and with you, at most at once and in parallel.
+pub(super) fn project_numbers(
+    items: &[&Item],
+    meta: &Value,
+    vocab: &Vocabulary,
+    now: i64,
+) -> Value {
+    let min = |values: Vec<Option<i64>>| values.into_iter().flatten().min();
+    let created = min(items.iter().map(|i| i.time("created_at")).collect());
+    let meta_created = meta
+        .get("created")
+        .and_then(Value::as_str)
+        .and_then(atm_common::time::parse_iso)
+        .map(|s| s * 1000);
+    let first_start = min(items.iter().map(|i| i.time("started_at")).collect());
+    let finished = |i: &&Item| matches!(i.kind, Some(Kind::Done | Kind::Skipped));
+    let open = items.iter().filter(|i| !finished(i)).count();
+    let last_done = items
+        .iter()
+        .filter(|i| i.kind == Some(Kind::Done))
+        .filter_map(|i| i.completed_at())
+        .max();
+    let duration = first_start.map(|from| {
+        if open > 0 {
+            json!({"from": from, "to": now, "ongoing": true})
+        } else {
+            json!({"from": from, "to": from.max(last_done.unwrap_or(from)), "ongoing": false})
+        }
+    });
+    let prs: std::collections::HashSet<i64> = items
+        .iter()
+        .filter_map(|i| {
+            i.task
+                .get("pr")
+                .and_then(|p| p.get("number"))
+                .and_then(Value::as_i64)
+        })
+        .collect();
+    let direct = meta
+        .get("workflow")
+        .and_then(|w| w.get("type"))
+        .and_then(Value::as_str)
+        == Some("direct");
+    let agents = agent_tasks(items);
+    let (together, alone): (Vec<&Item>, Vec<&Item>) = agents.iter().partition(|i| i.with_user);
+    let use_of = |list: &[&Item]| time_use(list, None, now);
+    let all = use_of(&agents);
+    let stretches: Vec<Interval> = work_of(&agents).into_iter().map(|(_, iv)| iv).collect();
+    let working: i64 = merge(&stretches).iter().map(|i| i.length()).sum();
+    let agent_ms = all.as_ref().map_or(0, |u| u.agent_ms);
+    #[allow(clippy::cast_precision_loss)] // reason: milliseconds, far below 2^52
+    let parallelism = (all.is_some() && working > 0).then(|| agent_ms as f64 / working as f64);
+    let count = |kind: Kind| items.iter().filter(|i| i.kind == Some(kind)).count();
+    json!({
+        "started": created.or(meta_created),
+        "duration": duration,
+        "tasks": {"total": items.len(), "done": count(Kind::Done), "open": open, "skipped": count(Kind::Skipped)},
+        "sprints": {
+            "total": vocab.sprints.len(),
+            "closed": vocab.sprints.iter().filter(|s| s.get("state").and_then(Value::as_str) == Some("closed")).count(),
+        },
+        "task_commits": items.iter().filter(|i| i.task.get("commit").and_then(Value::as_str).is_some_and(|c| !c.is_empty())).count(),
+        "pull_requests": if prs.is_empty() && direct { Value::Null } else { json!(prs.len()) },
+        "agent_ms": agent_ms,
+        "alone_ms": use_of(&alone).map_or(0, |u| u.agent_ms),
+        "with_you_ms": use_of(&together).map_or(0, |u| u.agent_ms),
+        "max_agents": all.as_ref().map_or(0, |u| u.max_agents),
+        "parallelism": parallelism,
+    })
+}
+
+/// Bins that widen with time, so short and long tasks both read: 0–5 m … 3–4 h, 4 h+.
+pub const TIME_BINS: [u32; 11] = [0, 5, 10, 20, 30, 45, 60, 90, 120, 180, 240];
+
+fn bin_label(m: u32) -> String {
+    if m < 60 {
+        format!("{m} m")
+    } else {
+        format!("{} h", f64::from(m) / 60.0)
+    }
+}
+
+/// Every done task's work time, binned (T-254), alone and with you apart; tasks with no work are left out.
+pub(super) fn histogram(items: &[&Item]) -> Value {
+    let timed: Vec<(&Item, f64)> = items
+        .iter()
+        .filter(|i| i.kind == Some(Kind::Done))
+        .filter_map(|i| i.work_minutes().map(|m| (*i, m)))
+        .collect();
+    let task = |(i, m): &(&Item, f64)| json!({"id": i.id, "key": i.key, "name": i.task.get("name"), "minutes": m, "with_you": i.with_user});
+    let bins: Vec<Value> = TIME_BINS
+        .iter()
+        .enumerate()
+        .map(|(n, &from)| {
+            let to = TIME_BINS.get(n + 1).copied();
+            let inside = |m: f64| m >= f64::from(from) && to.is_none_or(|t| m < f64::from(t));
+            let own: Vec<&(&Item, f64)> = timed.iter().filter(|(_, m)| inside(*m)).collect();
+            let label = to.map_or_else(|| format!("{}+", bin_label(from)), |t| format!("{}–{}", bin_label(from), bin_label(t)));
+            json!({
+                "from": from, "to": to, "label": label,
+                "alone": own.iter().filter(|(i, _)| !i.with_user).map(|t| task(t)).collect::<Vec<_>>(),
+                "with_you": own.iter().filter(|(i, _)| i.with_user).map(|t| task(t)).collect::<Vec<_>>(),
+            })
+        })
+        .collect();
+    let minutes: Vec<f64> = timed.iter().map(|(_, m)| *m).collect();
+    let of = |with: bool| -> Vec<f64> {
+        timed
+            .iter()
+            .filter(|(i, _)| i.with_user == with)
+            .map(|(_, m)| *m)
+            .collect()
+    };
+    let mut slowest: Vec<&(&Item, f64)> = timed.iter().collect();
+    slowest.sort_by(|a, b| b.1.total_cmp(&a.1));
+    #[allow(clippy::cast_precision_loss)] // reason: a count of tasks
+    let average = (!minutes.is_empty()).then(|| minutes.iter().sum::<f64>() / minutes.len() as f64);
+    json!({
+        "bins": bins,
+        "median_alone": median(&of(false)),
+        "median_with_you": median(&of(true)),
+        "min": minutes.iter().copied().reduce(f64::min),
+        "max": minutes.iter().copied().reduce(f64::max),
+        "average": average,
+        "slowest": slowest.into_iter().take(5).map(task).collect::<Vec<_>>(),
+    })
+}
