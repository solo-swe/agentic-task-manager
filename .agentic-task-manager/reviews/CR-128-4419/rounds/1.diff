--- /dev/null
+++ b/crates/atm-lib/src/lookup.rs
@@ -0,0 +1,58 @@
+//! Finding a task in a change (ATM-681): its position among the working tasks, or the error every command gives for
+//! one that isn't there, saying when it is archived; and one change run over the tasks of both files.
+
+use atm_common::{Error, Result};
+use atm_db::working::Working;
+use serde_json::Value;
+
+/// The error for a task that isn't among the working tasks; `archived`, when the archive has it.
+pub(crate) fn no_task(task_id: &str, archived: bool) -> Error {
+    let hint = if archived {
+        " (it is archived: atm db unarchive brings it back)"
+    } else {
+        ""
+    };
+    Error::NotFound(format!("no task {task_id}{hint}"))
+}
+
+fn has_id(task: &Value, task_id: &str) -> bool {
+    task.get("id").and_then(Value::as_str) == Some(task_id)
+}
+
+/// The position of the task with this ID among the change's working tasks.
+///
+/// # Errors
+/// [`no_task`] when it isn't there (saying when the archive has it); an archive that can't be read.
+pub(crate) fn task_at(work: &mut Working, task_id: &str) -> Result<usize> {
+    if let Some(at) = work.document["tasks"]
+        .as_array()
+        .and_then(|list| list.iter().position(|t| has_id(t, task_id)))
+    {
+        return Ok(at);
+    }
+    let archived = work.archive()?["tasks"]
+        .as_array()
+        .is_some_and(|list| list.iter().any(|t| has_id(t, task_id)));
+    Err(no_task(task_id, archived))
+}
+
+/// `change` run over the working tasks, then the archived ones (a rename: every task naming something follows it);
+/// none when a file has no task list. Returns what it counted in each, working first.
+///
+/// # Errors
+/// An archive that can't be read.
+pub(crate) fn in_both(
+    work: &mut Working,
+    mut change: impl FnMut(Option<&mut Vec<Value>>) -> usize,
+) -> Result<(usize, usize)> {
+    let working = change(work.document["tasks"].as_array_mut());
+    let archived = change(
+        work.archive()?
+            .get_mut("tasks")
+            .and_then(Value::as_array_mut),
+    );
+    Ok((working, archived))
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/crates/atm-lib/src/lookup/tests.rs b/crates/atm-lib/src/lookup/tests.rs
new file mode 100644
index 00000000..db5542d4
--- /dev/null
+++ b/crates/atm-lib/src/lookup/tests.rs
@@ -0,0 +1,76 @@
+use atm_db::MemoryStore;
+use serde_json::{Map, Value, json};
+
+use super::*;
+use crate::project::Project;
+
+fn task(v: &Value) -> atm_common::Task {
+    v.as_object().unwrap().clone()
+}
+
+fn project(working: &[Value], archived: &[Value]) -> Project {
+    let store = MemoryStore::new(
+        working.iter().map(task).collect(),
+        archived.iter().map(task).collect(),
+        &Map::new(),
+    )
+    .unwrap();
+    Project::new(Box::new(store))
+}
+
+#[test]
+fn a_change_in_both_runs_on_the_working_tasks_then_the_archived_ones() {
+    let mut p = project(
+        &[json!({"id": "T-1", "x": 1}), json!({"id": "T-2"})],
+        &[json!({"id": "T-0", "x": 1})],
+    );
+    let mut seen = Vec::new();
+    let counts = p
+        .change(|work| {
+            in_both(work, |list| {
+                let list = list.expect("both files have a task list");
+                seen.push(list.len());
+                list.iter_mut()
+                    .filter(|t| t.get("x").is_some())
+                    .map(|t| t["x"] = json!(2))
+                    .count()
+            })
+        })
+        .unwrap();
+    assert_eq!(counts, (1, 1));
+    assert_eq!(seen, [2, 1], "the working tasks first");
+    let store = p.store();
+    assert_eq!(store.get_task("T-1").unwrap().unwrap()["x"], json!(2));
+    assert_eq!(
+        store.get_archived_task("T-0").unwrap().unwrap()["x"],
+        json!(2)
+    );
+}
+
+#[test]
+fn a_task_is_found_by_its_place_and_a_missing_one_says_whether_it_is_archived() {
+    let mut p = project(
+        &[json!({"id": "T-1"}), json!({"id": "T-2"})],
+        &[json!({"id": "T-0"})],
+    );
+    let found = |p: &mut Project, id: &str| p.change(|work| task_at(work, id));
+    assert_eq!(found(&mut p, "T-2").unwrap(), 1);
+    assert_eq!(found(&mut p, "T-1").unwrap(), 0);
+    for (id, message) in [
+        (
+            "T-0",
+            "no task T-0 (it is archived: atm db unarchive brings it back)",
+        ),
+        ("T-9", "no task T-9"),
+    ] {
+        let err = found(&mut p, id).unwrap_err();
+        assert!(matches!(err, Error::NotFound(_)), "{id}");
+        assert_eq!(err.to_string(), message, "{id}");
+    }
+    // No working tasks at all: still not found
+    let mut empty = project(&[], &[]);
+    assert_eq!(
+        found(&mut empty, "T-1").unwrap_err().to_string(),
+        "no task T-1"
+    );
+}
