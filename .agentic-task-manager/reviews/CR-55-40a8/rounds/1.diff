+        assert!(names(&["~ATM-9"], "ATM-14"));
+        assert!(names(&["atm-9", "ATM-12"], "ATM-14"));
+        // A key a task holds now names that task, not the one that moved off it
+        assert!(names(&["ATM-12"], "ATM-12"));
+        assert!(!names(&["ATM-12"], "ATM-13"));
