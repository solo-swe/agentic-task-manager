@@ -138,6 +138,51 @@ describe('release workflows (I18, I19; T-452)', () => {
     for (const name of ['build', 'app-macos']) expect(job(name)).toMatch(/^ {4}needs: tag$/m);
     expect(job('release')).toMatch(/^ {4}needs: \[build, app-macos\]$/m);
