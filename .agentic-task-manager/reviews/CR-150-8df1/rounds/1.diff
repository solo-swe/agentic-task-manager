+pub fn listing_of(state: Option<&str>) -> Result<Listing> {
+    match state {
+        None | Some("created") => Ok(Listing::Open),
+        Some("all") => Ok(Listing::All),
+        Some(other) => InboxState::parse(other)
+            .map(Listing::In)
+            .ok_or_else(|| Error::Invalid(format!("no inbox state {other:?}"))),
+    }
