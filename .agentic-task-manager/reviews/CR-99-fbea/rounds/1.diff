+
+    /// No events
+    const NONE: [String; 0] = [];
+
+    #[test]
+    fn a_new_file_gets_the_hooks_alone_and_uninstalling_them_leaves_an_empty_object() {
+        let project = dir();
+        install_hooks(Some(project.path())).unwrap();
+        let after = settings_of(project.path());
