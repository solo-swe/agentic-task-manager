+}
+
+/// ADR-009: keys are plain from creation, so `key_final` leaves every task of `tasks.json` and the archive, once (a file
+/// without it is left as it is). How many tasks it was dropped from.
+fn drop_key_final(paths: &Paths) -> Result<usize> {
+    let count = |document: &Value| {
+        with_key_final(document["tasks"].as_array().map_or(&[][..], Vec::as_slice))
+    };
+    let precheck = || -> Result<usize> {
+        Ok(count(&load_tasks(paths)?.document) + count(&archive_document(paths)?))
+    };
+    if precheck().unwrap_or(0) == 0 {
+        return Ok(0);
+    }
+    let archive = paths.archive();
+    let (written, dropped) = {
+        let _lock = lock(&paths.dir, None)?;
+        let mut document = load_tasks(paths)?.document;
+        let mut archived = archive_document(paths)?;
+        let dropped = count(&document) + count(&archived);
+        let strip = |tasks: &mut [Value]| {
+            for task in tasks.iter_mut().filter_map(Value::as_object_mut) {
+                task.shift_remove("key_final");
+            }
+        };
+        if let Some(tasks) = document["tasks"].as_array_mut() {
+            strip(tasks);
+        }
+        strip(tasks_mut(&mut archived));
+        write_json(&paths.tasks, &document)?;
+        let mut written = vec![paths.tasks.clone()];
+        if archive.is_file() {
+            write_json(&archive, &archived)?;
+            written.push(archive.clone());
+        }
+        (written, dropped)
+    };
+    if in_git(&paths.root) {
+        let files: Vec<&Path> = written.iter().map(std::path::PathBuf::as_path).collect();
+        stage(&paths.root, &files);
+    }
+    Ok(dropped)
+}
