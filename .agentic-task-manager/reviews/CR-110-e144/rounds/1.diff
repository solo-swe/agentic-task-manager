+        (Method::PUT, "/CR-1"),
+        (Method::POST, "/CR-1/tasks"),
+        (Method::PATCH, "/CR-1/tasks"),
+        (Method::PUT, "/CR-1/decisions"),
+        (Method::PATCH, "/CR-1/decisions"),
+        (Method::PUT, "/CR-1/comments"),
+        (Method::PATCH, "/CR-1/comments"),
+        (Method::POST, "/CR-1/comments/c1"),
