+fn send(fake: Fake, method: &Method, resource: &str, body: Value) -> (Answer, Vec<Call>) {
+    let (projects, calls) = fake.projects();
+    let answer = answer(serve_review_change(
+        &projects,
+        method,
+        &format!("{REVIEWS}{resource}"),
+        body,
+    ));
+    (answer, calls.taken())
+}
