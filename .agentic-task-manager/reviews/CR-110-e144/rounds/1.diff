+        );
+        assert_eq!(answer.unstamped(), answered, "{method} {resource}");
+        assert!(answer.json()["generated_at"].is_string());
+        assert_eq!(answer.header("cache-control"), "no-store");
+        assert_eq!(
+            calls,
+            [
+                Call::Project("work".into(), "p1".into()),
+                Call::AsUser,
+                call
+            ],
+            "{method} {resource}"
