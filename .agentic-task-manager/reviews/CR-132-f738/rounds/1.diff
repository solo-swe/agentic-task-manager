+/// The name `--agent` gives (before any `--`): `--agent NAME` or `--agent=NAME`; an empty one when it has none.
+fn agent_arg(args: &[OsString]) -> Option<String> {
+    let args: Vec<String> = args
+        .iter()
+        .take_while(|a| *a != "--")
+        .map(|a| a.to_string_lossy().into_owned())
