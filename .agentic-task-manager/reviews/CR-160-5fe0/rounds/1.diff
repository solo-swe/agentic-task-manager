+    expect(title('/projects/atm/documents')).toEqual({ title: 'ATM - Documents', icon: 'file-text' });
+    for (const view of ['progress', 'agents'])
+      expect(title(`/projects/atm/${view}`), view).toEqual({ title: 'ATM - Analysis', icon: 'trending-up' });
