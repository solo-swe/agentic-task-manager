+        `diff --git a/${path} b/${path}\nnew file mode 100644\n--- /dev/null\n+++ b/${path}\n@@ -0,0 +1,40 @@\n` +
+        text
+          .trimEnd()
+          .split('\n')
+          .map((l) => `+${l}`)
+          .join('\n') +
+        '\n';
