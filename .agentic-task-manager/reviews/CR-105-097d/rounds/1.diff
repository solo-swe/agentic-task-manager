new file mode 100644
index 00000000..b29b3064
--- /dev/null
+++ b/crates/atm-cli/src/commands/review/listen.rs
@@ -0,0 +1,225 @@
+//! Listening to the reviews: `wait`, `watch` and `inbox` (with Claude Code's hook).
+
+use super::{
+    Context, Error, Path, Result, ReviewCommand, Value, actor, json, opened, print_json, reference,
+    summary_line,
+};
+
+/// Run one of this group's review commands in `cwd` (`super::run` gives it only these).
+///
+/// # Errors
+/// What the review's rules or atm-lib refuse, and a project or review that can't be read.
+#[allow(clippy::too_many_lines)] // reason: one arm per command
+pub(super) fn run(command: ReviewCommand, ctx: Context, cwd: &Path) -> Result<u8> {
+    match command {
+        ReviewCommand::Wait {
+            review,
+            until,
+            timeout,
+            agent,
+        } => {
+            let project = opened(cwd, agent.as_deref())?;
+            let me = actor(&project);
+            let until = if until == "decision" {
+                atm_lib::review_listen::WaitFor::Decision
+            } else {
+                atm_lib::review_listen::WaitFor::Submitted
+            };
+            let waited = atm_lib::review_listen::wait(
+                &project,
+                &reference(&review),
+                until,
+                duration_of(&timeout)?,
+                &me.0,
+            )?;
+            let Some(waited) = waited else {
+                if ctx.json {
+                    print_json(&json!({ "review": review, "timed_out": true }));
+                } else {
+                    println!("{review}: nothing yet (the time is up)");
+                }
+                return Ok(3);
+            };
+            if ctx.json {
+                print_json(&waited);
+            } else {
+                let header: atm_lib::reviews::ReviewHeader =
+                    serde_json::from_value(waited["review"].clone())
+                        .map_err(|e| Error::failed(e.to_string()))?;
+                println!("{}", summary_line(&header));
+                for heard in waited["comments"].as_array().into_iter().flatten() {
+                    println!("  {}", heard_line(heard));
+                }
+            }
+            Ok(0)
+        }
+        ReviewCommand::Watch {
+            timeout,
+            once,
+            since,
+            agent,
+        } => {
+            let project = opened(cwd, agent.as_deref())?;
+            let me = actor(&project);
+            let mut ready = || eprintln!("Watching the reviews for {}'s work.", me.0);
+            let mut emit = |heard: Value| {
+                if ctx.json {
+                    // One object a line, exactly, as print_json prints (I30): a reader takes each as it comes
+                    ::std::println!("{heard}");
+                } else {
+                    println!("{}", heard_line(&heard));
+                }
+            };
+            let told = atm_lib::review_listen::watch(
+                &project,
+                &me.0,
+                duration_of(&timeout)?,
+                &atm_lib::review_listen::WatchOptions { once, since },
+                &mut ready,
+                &mut emit,
+            )?;
+            // --once with nothing told by the time up: exit code 3, as `atm review wait` (ATM-624)
+            Ok(if once && told == 0 { 3 } else { 0 })
+        }
+        ReviewCommand::Inbox {
+            peek: _,
+            hook: true,
+            agent,
+        } => Ok(hook_inbox(cwd, agent.as_deref())),
+        ReviewCommand::Inbox {
+            peek,
+            hook: false,
+            agent,
+        } => {
+            let project = opened(cwd, agent.as_deref())?;
+            let me = actor(&project);
+            let unread = atm_lib::review_listen::inbox(&project, &me.0, !peek)?;
+            if ctx.json {
+                for event in &unread {
+                    // One object a line, as the watch prints them (I30)
+                    ::std::println!("{event}");
+                }
+            } else if unread.is_empty() {
+                println!("Nothing unread about your work.");
+            } else {
+                for event in &unread {
+                    match event["decision"].as_str() {
+                        Some(decision) => println!(
+                            "{}{}: {}",
+                            event["review"].as_str().unwrap_or_default(),
+                            event["task"]
+                                .as_str()
+                                .map(|t| format!(" ({t})"))
+                                .unwrap_or_default(),
+                            decision.replace('_', " ")
+                        ),
+                        None => println!("{}", heard_line(event)),
+                    }
+                }
+            }
+            Ok(0)
+        }
+        _ => unreachable!("review::run gives listen::run only its own commands"),
+    }
+}
+
+/// The most of Claude Code's hook input read from stdin.
+pub(super) const HOOK_INPUT_BYTES: u64 = 1024 * 1024;
+
+/// `atm review inbox --hook` (ATM-708): Claude Code's hook. Its input on stdin names the session, its folder and the
+/// event; the session's unread review events are its answer on stdout, read from then on: context for the agent
+/// (`UserPromptSubmit`, `PostToolUse`), or its reply held (`Stop`). Always exit code 0 and nothing printed when there
+/// is nothing to say, the input isn't Claude Code's, or the folder holds no project: a hook never stands in the way.
+pub(super) fn hook_inbox(cwd: &Path, agent: Option<&str>) -> u8 {
+    use std::io::Read;
+    let mut text = String::new();
+    if std::io::stdin()
+        .take(HOOK_INPUT_BYTES)
+        .read_to_string(&mut text)
+        .is_err()
+    {
+        return 0;
+    }
+    let input: Value = serde_json::from_str(&text).unwrap_or(Value::Null);
+    let Some(event) = input["hook_event_name"].as_str() else {
+        return 0;
+    };
+    if !atm_lib::agent_hooks::HOOK_EVENTS.contains(&event) {
+        return 0;
+    }
+    let folder = input["cwd"]
+        .as_str()
+        .map_or_else(|| cwd.to_path_buf(), std::path::PathBuf::from);
+    let Ok(project) = atm_lib::Project::open(&folder) else {
+        return 0;
+    };
+    // The session's identity, as its own commands have it: from the input, as a hook's environment may not name it
+    let me = match (agent, input["session_id"].as_str()) {
+        (Some(agent), _) if !agent.is_empty() => agent.to_string(),
+        (_, Some(session)) if std::env::var("ATM_AGENT").map_or(true, |a| a.is_empty()) => {
+            atm_lib::actor::session_identity(session, &folder)
+        }
+        _ => atm_lib::actor::agent_identity(None, &folder),
+    };
+    let Ok(unread) = atm_lib::review_listen::inbox(&project, &me, true) else {
+        return 0;
+    };
+    if let Some(answer) = atm_lib::agent_hooks::hook_answer(event, &unread) {
+        ::std::println!("{answer}");
+    }
+    0
+}
+
+/// A comment heard, for people: where, who, and its text.
+pub(super) fn heard_line(heard: &Value) -> String {
+    let text = |key: &str| {
+        heard
+            .get(key)
+            .and_then(Value::as_str)
+            .unwrap_or_default()
+            .to_string()
+    };
+    let task = heard
+        .get("task")
+        .and_then(Value::as_str)
+        .map_or_else(String::new, |t| format!(" ({t})"));
+    let place = match (
+        heard.get("path").and_then(Value::as_str),
+        heard.get("lines").and_then(Value::as_array),
+    ) {
+        (Some(path), Some(lines)) => format!(" on {path}:{}-{}", lines[0], lines[1]),
+        (Some(path), None) => format!(" on {path}"),
+        _ => String::new(),
+    };
+    format!(
+        "{} {}{task}{place}, {}: {}",
+        text("review"),
+        text("comment"),
+        text("author"),
+        text("body").replace('\n', " ")
+    )
+}
+
+/// `90s`, `30m`, `2h`, or seconds without a unit.
+pub(super) fn duration_of(text: &str) -> Result<std::time::Duration> {
+    let bad = || {
+        Error::Invalid(format!(
+            "--timeout takes 90s, 30m, 2h or seconds, not {text}"
+        ))
+    };
+    let (number, unit) = match text.char_indices().last() {
+        Some((at, 's' | 'm' | 'h')) => (&text[..at], &text[at..]),
+        _ => (text, "s"),
+    };
+    let n: f64 = number.parse().map_err(|_| bad())?;
+    if !n.is_finite() || n <= 0.0 {
+        return Err(bad());
+    }
+    let seconds = n * match unit {
+        "m" => 60.0,
+        "h" => 3600.0,
+        _ => 1.0,
+    };
+    // A number too large for a Duration (1e20) is refused, never a panic (ATM-666, audit C5)
+    std::time::Duration::try_from_secs_f64(seconds).map_err(|_| bad())
+}
diff --git a/crates/atm-cli/src/commands/review/open.rs b/crates/atm-cli/src/commands/review/open.rs
new file mode 100644
index 00000000..7ef3baff
--- /dev/null
+++ b/crates/atm-cli/src/commands/review/open.rs
@@ -0,0 +1,167 @@
+//! Opening a review and its rounds: `create`, `live`, `round`, `tasks`.
+
+use super::{
+    Actor, Change, Context, NewReview, Path, Result, ReviewCommand, ReviewStore, Status, Value,
+    actor, json, new_round, opened, print_json, reference, reviews, summary_line,
+};
+
+/// Run one of this group's review commands in `cwd` (`super::run` gives it only these).
+///
+/// # Errors
+/// What the review's rules or atm-lib refuse, and a project or review that can't be read.
+#[allow(clippy::too_many_lines)] // reason: one arm per command
+pub(super) fn run(command: ReviewCommand, ctx: Context, cwd: &Path) -> Result<u8> {
+    match command {
+        ReviewCommand::Create {
+            title,
+            tasks,
+            change,
+            summary_file,
+            reviewers,
+            draft,
+            agent,
+        } => {
+            let mut project = opened(cwd, agent.as_deref())?;
+            let summary = match summary_file {
+                Some(file) => crate::option_file::read_option_file(cwd, "summary-file", &file)?,
+                None => String::new(),
+            };
+            let first = new_round(&project, change, cwd, None, &[])?;
+            if ctx.dry_run {
+                println!(
+                    "[dry-run] would open a review “{title}” of {} file(s)",
+                    first.files.len()
+                );
+                return Ok(0);
+            }
+            let author = actor(&project);
+            let header = reviews::create(
+                &mut project,
+                NewReview {
+                    title,
+                    summary,
+                    tasks,
+                    author: Some(author),
+                    reviewers: reviewers.into_iter().map(Actor).collect(),
+                    status: if draft {
+                        Status::Draft
+                    } else {
+                        Status::Waiting
+                    },
+                    first,
+                },
+            )?;
+            if ctx.json {
+                print_json(&as_json!(&header));
+            } else {
+                println!("Opened {}", summary_line(&header));
+            }
+        }
+        ReviewCommand::Live {
+            base,
+            tasks,
+            title,
+            reviewers,
+            agent,
+        } => {
+            let mut project = opened(cwd, agent.as_deref())?;
+            let change = Change {
+                uncommitted: true,
+                base,
+                ..Change::default()
+            };
+            let first = new_round(&project, change, cwd, None, &[])?;
+            if ctx.dry_run {
+                println!("[dry-run] would open a live review “{title}”");
+                return Ok(0);
+            }
+            let author = actor(&project);
+            let header = reviews::create(
+                &mut project,
+                NewReview {
+                    title,
+                    summary: String::new(),
+                    tasks,
+                    // A person opening it reviews an agent's work: atm-lib names the author (§3.5)
+                    author: Some(author),
+                    reviewers: reviewers.into_iter().map(Actor).collect(),
+                    status: Status::Live,
+                    first,
+                },
+            )?;
+            if ctx.json {
+                print_json(&as_json!(&header));
+            } else {
+                println!("Opened {}", summary_line(&header));
+            }
+        }
+        ReviewCommand::Round {
+            review,
+            change,
+            summary_file,
+            agent,
+        } => {
+            let mut project = opened(cwd, agent.as_deref())?;
+            let store = reviews::store(&project)?;
+            let found = store.get_review(&reference(&review))?;
+            let last = found.rounds.last();
+            let files: Vec<String> = last
+                .map(|r| r.files.iter().map(|f| f.path.clone()).collect())
+                .unwrap_or_default();
+            // The new summary read before anything is written
+            let summary = summary_file
+                .map(|file| crate::option_file::read_option_file(cwd, "summary-file", &file))
+                .transpose()?;
+            let round = new_round(&project, change, cwd, last, &files)?;
+            if ctx.dry_run {
+                let with = if summary.is_some() {
+                    ", with a new summary"
+                } else {
+                    ""
+                };
+                println!(
+                    "[dry-run] would add a round to {}{with}",
+                    found.header.reference
+                );
+                return Ok(0);
+            }
+            let number = reviews::add_round(&mut project, &found.header.reference, round)?;
+            if let Some(summary) = summary {
+                reviews::edit_summary(&mut project, &found.header.reference, summary.trim_end())?;
+            }
+            if ctx.json {
+                print_json(&json!({ "review": found.header.reference, "round": number }));
+            } else {
+                println!("{}: round {number}", found.header.reference);
+            }
+        }
+        ReviewCommand::Tasks {
+            review,
+            add,
+            remove,
+            agent,
+        } => {
+            let mut project = opened(cwd, agent.as_deref())?;
+            if ctx.dry_run {
+                println!("[dry-run] would change {review}'s tasks");
+                return Ok(0);
+            }
+            let header = reviews::set_tasks(&mut project, &reference(&review), &add, &remove)?;
+            if ctx.json {
+                print_json(&as_json!(&header));
+            } else {
+                println!(
+                    "{}: {}",
+                    header.reference,
+                    if header.tasks.is_empty() {
+                        "no tasks".into()
+                    } else {
+                        header.tasks.join(", ")
+                    }
+                );
+            }
+        }
+        _ => unreachable!("review::run gives open::run only its own commands"),
+    }
+    Ok(0)
+}
diff --git a/crates/atm-cli/src/commands/review/read.rs b/crates/atm-cli/src/commands/review/read.rs
new file mode 100644
index 00000000..afc410ee
--- /dev/null
+++ b/crates/atm-cli/src/commands/review/read.rs
@@ -0,0 +1,210 @@
+//! Reading the reviews: `list`, `show`, `comments`.
+
+use super::{
+    CommentFilter, CommentsFile, Context, Error, FileStore, Path, Result, ReviewCommand,
+    ReviewFilter, ReviewRef, ReviewStore, RoundKind, Value, actor, comments_md, json, opened,
+    print_json, reference, reviews, rounds, status_of, summary_line, vcs_of,
+};
+
+/// Run one of this group's review commands in `cwd` (`super::run` gives it only these).
+///
+/// # Errors
+/// What the review's rules or atm-lib refuse, and a project or review that can't be read.
+#[allow(clippy::too_many_lines)] // reason: one arm per command
+pub(super) fn run(command: ReviewCommand, ctx: Context, cwd: &Path) -> Result<u8> {
+    match command {
+        ReviewCommand::List {
+            statuses,
+            task,
+            mine,
+            search,
+        } => {
+            let project = opened(cwd, None)?;
+            let me = actor(&project);
+            let filter = ReviewFilter {
+                statuses: statuses
+                    .iter()
+                    .map(|s| status_of(s))
+                    .collect::<Result<Vec<_>>>()?
+                    .concat(),
+                task: task.map(|t| reviews::task_reference(&project, &t)),
+            };
+            let root = project
+                .root()
+                .ok_or_else(|| Error::failed("no project here"))?;
+            let store = reviews::store(&project)?;
+            let words: Vec<String> = search
+                .as_deref()
+                .unwrap_or_default()
+                .split_whitespace()
+                .map(str::to_lowercase)
+                .collect();
+            let mut found = Vec::new();
+            for f in reviews::list_naming(&project, root, &filter)? {
+                if mine
+                    && f.header.author.as_ref() != Some(&me)
+                    && !f.header.reviewers.contains(&me)
+                {
+                    continue;
+                }
+                if !words.is_empty() {
+                    let review = FileStore::open(&f.working_copy.join(atm_common::TASK_DIR))
+                        .and_then(|s| s.get_review(&ReviewRef(f.header.id.0.clone())))
+                        .or_else(|_| store.get_review(&f.header.reference))?;
+                    let mut text = format!("{} {}", review.header.title, review.summary);
+                    for comment in review.comments() {
+                        text.push(' ');
+                        text.push_str(&comment.body);
+                    }
+                    let text = text.to_lowercase();
+                    if !words.iter().all(|w| text.contains(w)) {
+                        continue;
+                    }
+                }
+                found.push(f);
+            }
+            // Whatever the filter (ATM-617): a review atm can't read is listed as such, never left out without a word.
+            // With --json, on stderr: the list stays the array older readers expect
+            let unreadable: Vec<String> = store
+                .unreadable()?
+                .iter()
+                .map(|u| {
+                    format!(
+                        "{} ({}): can't be read: {}. A newer atm may have written it.",
+                        u.reference, u.folder, u.problem
+                    )
+                })
+                .collect();
+            if ctx.json {
+                print_json(&Value::Array(
+                    found
+                        .iter()
+                        .map(|f| json!({ "review": as_json!(&f.header), "branch": f.branch }))
+                        .collect(),
+                ));
+                for line in &unreadable {
+                    eprintln!("atm: {line}");
+                }
+            } else {
+                if found.is_empty() {
+                    println!("No reviews.");
+                }
+                for f in &found {
+                    let branch = f
+                        .branch
+                        .as_deref()
+                        .map_or_else(String::new, |b| format!(" · {b}"));
+                    println!("{}{branch}", summary_line(&f.header));
+                }
+                for line in &unreadable {
+                    println!("{line}");
+                }
+            }
+        }
+        ReviewCommand::Show {
+            review,
+            round,
+            against,
+        } => {
+            let project = opened(cwd, None)?;
+            let store = reviews::store(&project)?;
+            let found = store.get_review(&reference(&review))?;
+            if let Some(round) = round {
+                let patch = match against {
+                    Some(from) => rounds::compare(&vcs_of(&project)?, &store, &found, from, round)?,
+                    None => store.round_diff(&found.header.id, round)?,
+                };
+                if ctx.json {
+                    print_json(
+                        &json!({ "review": found.header.reference, "round": round, "against": against, "diff": patch.0 }),
+                    );
+                } else {
+                    print!("{}", patch.0);
+                }
+                return Ok(0);
+            }
+            if ctx.json {
+                print_json(&as_json!(&found));
+                return Ok(0);
+            }
+            println!("{}", summary_line(&found.header));
+            let reviewers: Vec<&str> = found
+                .header
+                .reviewers
+                .iter()
+                .map(|r| r.0.as_str())
+                .collect();
+            println!(
+                "  by {} · {} · opened {}",
+                found
+                    .header
+                    .author
+                    .as_ref()
+                    .map_or("nobody yet (an agent's first round names them)", |a| a
+                        .0
+                        .as_str()),
+                if reviewers.is_empty() {
+                    "decided by anyone but its author".to_string()
+                } else {
+                    format!("decided by {}", reviewers.join(", "))
+                },
+                found.header.created
+            );
+            if !found.summary.is_empty() {
+                println!();
+                for line in found.summary.lines() {
+                    println!("  {line}");
+                }
+            }
+            println!();
+            for r in &found.rounds {
+                let what = match &r.kind {
+                    RoundKind::Range { base, head } => format!(
+                        "{}..{}",
+                        &base[..base.len().min(7)],
+                        &head[..head.len().min(7)]
+                    ),
+                    RoundKind::Working { base } => {
+                        format!("uncommitted, on {}", &base[..base.len().min(7)])
+                    }
+                    RoundKind::Files => "files as they are".into(),
+                };
+                println!(
+                    "  round {} · {what} · {} file(s) · {} · {}",
+                    r.number,
+                    r.files.len(),
+                    r.by.0,
+                    r.at
+                );
+            }
+            let open = found.open_comments().count();
+            println!("  {} chain(s), {open} open", found.chains.len());
+        }
+        ReviewCommand::Comments { review, open } => {
+            let project = opened(cwd, None)?;
+            let store = reviews::store(&project)?;
+            let found = store.get_review(&reference(&review))?;
+            let chains =
+                store.list_comments(&found.header.id, &CommentFilter { open_only: open })?;
+            if ctx.json {
+                print_json(&as_json!(&chains));
+            } else if chains.is_empty() {
+                println!(
+                    "{}: no comments{}",
+                    found.header.reference,
+                    if open { " open" } else { "" }
+                );
+            } else {
+                print!(
+                    "{}",
+                    comments_md::write(&CommentsFile {
+                        chains,
+                        unread: Vec::new()
+                    })
+                );
+            }
+        }
+        _ => unreachable!("review::run gives read::run only its own commands"),
+    }
+    Ok(0)
+}
diff --git a/crates/atm-cli/src/commands/review/talk.rs b/crates/atm-cli/src/commands/review/talk.rs
new file mode 100644
index 00000000..d310c70c
--- /dev/null
+++ b/crates/atm-cli/src/commands/review/talk.rs
@@ -0,0 +1,276 @@
+//! Talking in a review: `comment`, `poke`, `reply`, `edit`, `resolve`, and the drafts.
+
+use super::{
+    CommentId, Context, DraftCommand, Error, Path, Result, ReviewCommand, ReviewStore, Reviews,
+    Side, Value, actor, json, opened, print_json, reference, reviews, text_of,
+};
+
+/// Run one of this group's review commands in `cwd` (`super::run` gives it only these).
+///
+/// # Errors
+/// What the review's rules or atm-lib refuse, and a project or review that can't be read.
+#[allow(clippy::too_many_lines)] // reason: one arm per command
+pub(super) fn run(command: ReviewCommand, ctx: Context, cwd: &Path) -> Result<u8> {
+    match command {
+        ReviewCommand::Comment {
+            review,
+            file,
+            lines,
+            quote,
+            old,
+            round,
+            body,
+            agent,
+        } => {
+            let project = opened(cwd, agent.as_deref())?;
+            let text = text_of(body, cwd)?;
+            let found = reviews::store(&project)?.get_review(&reference(&review))?;
+            let comment = atm_lib::review_requests::NewComment {
+                path: file,
+                lines: lines.as_deref().map(parse_lines).transpose()?,
+                side: if old { Side::Old } else { Side::New },
+                quote,
+                round,
+                body: text,
+            };
+            if ctx.dry_run {
+                println!("[dry-run] would comment on {}", found.header.reference);
+                return Ok(0);
+            }
+            // On a live review, the working copy as it is now first becomes a checkpoint (ATM-576)
+            let id =
+                atm_lib::review_requests::add_comment(&project, &found.header.reference, comment)?;
+            if ctx.json {
+                print_json(&json!({ "review": found.header.reference, "comment": id }));
+            } else {
+                println!("{}: {id}", found.header.reference);
+            }
+        }
+        ReviewCommand::Poke {
+            review,
+            body,
+            agent,
+        } => {
+            let project = opened(cwd, agent.as_deref())?;
+            if ctx.dry_run {
+                println!("[dry-run] would poke {review}");
+                return Ok(0);
+            }
+            let id = atm_lib::review_requests::poke_review(
+                &project,
+                &reference(&review),
+                &atm_lib::review_requests::NewPoke { body },
+            )?;
+            if ctx.json {
+                print_json(&json!({ "review": review, "poke": id }));
+            } else {
+                println!("{review}: poked ({id})");
+            }
+        }
+        ReviewCommand::Draft { command } => return run_draft(command, ctx, cwd),
+        ReviewCommand::Reply {
+            review,
+            comment,
+            body,
+            agent,
+        } => {
+            let project = opened(cwd, agent.as_deref())?;
+            let text = text_of(body, cwd)?;
+            let mut store = reviews::store(&project)?;
+            if ctx.dry_run {
+                println!("[dry-run] would reply to {comment} in {review}");
+                return Ok(0);
+            }
+            let id = Reviews::new(&mut store).reply(
+                &reference(&review),
+                &CommentId(comment.clone()),
+                &text,
+                &actor(&project),
+            )?;
+            if ctx.json {
+                print_json(&json!({ "review": review, "comment": id, "reply_to": comment }));
+            } else {
+                println!("{review}: {id}, in reply to {comment}");
+            }
+        }
+        ReviewCommand::Edit {
+            review,
+            comment,
+            body,
+            agent,
+        } => {
+            let project = opened(cwd, agent.as_deref())?;
+            let text = text_of(body, cwd)?;
+            let mut store = reviews::store(&project)?;
+            if ctx.dry_run {
+                println!("[dry-run] would edit {comment} in {review}");
+                return Ok(0);
+            }
+            Reviews::new(&mut store).edit(
+                &reference(&review),
+                &CommentId(comment.clone()),
+                &text,
+                &actor(&project),
+            )?;
+            if ctx.json {
+                print_json(&json!({ "review": review, "comment": comment }));
+            } else {
+                println!("{review}: {comment} changed");
+            }
+        }
+        ReviewCommand::Resolve {
+            review,
+            comment,
+            reopen,
+            agent,
+        } => {
+            let project = opened(cwd, agent.as_deref())?;
+            let mut store = reviews::store(&project)?;
+            if ctx.dry_run {
+                println!(
+                    "[dry-run] would {} {comment} in {review}",
+                    if reopen { "reopen" } else { "resolve" }
+                );
+                return Ok(0);
+            }
+            Reviews::new(&mut store).resolve(
+                &reference(&review),
+                &CommentId(comment.clone()),
+                !reopen,
+                &actor(&project),
+            )?;
+            if ctx.json {
+                print_json(&json!({ "review": review, "comment": comment, "resolved": !reopen }));
+            } else {
+                println!(
+                    "{review}: {comment} {}",
+                    if reopen { "open again" } else { "resolved" }
+                );
+            }
+        }
+        _ => unreachable!("review::run gives talk::run only its own commands"),
+    }
+    Ok(0)
+}
+
+/// A draft, for people: its ID, where it goes, its text.
+pub(super) fn draft_line(draft: &atm_lib::review_drafts::Draft) -> String {
+    use atm_lib::review_drafts::Place;
+    let place = match &draft.place {
+        Place::Reply { to } => format!("reply to {to}"),
+        Place::Comment {
+            path: Some(path),
+            lines: Some((a, b)),
+            ..
+        } => format!("{path}:{a}-{b}"),
+        Place::Comment {
+            path: Some(path), ..
+        } => path.clone(),
+        Place::Comment { .. } => "the review".into(),
+    };
+    format!("{} ({place}): {}", draft.id, draft.body.replace('\n', " "))
+}
+
+/// Run a draft command.
+pub(super) fn run_draft(command: DraftCommand, ctx: Context, cwd: &Path) -> Result<u8> {
+    use atm_lib::review_drafts::{self as drafts, DraftUpdate, NewDraft};
+    match command {
+        DraftCommand::Add {
+            review,
+            reply_to,
+            file,
+            lines,
+            quote,
+            old,
+            round,
+            body,
+            agent,
+        } => {
+            let project = opened(cwd, agent.as_deref())?;
+            let new = NewDraft {
+                reply_to,
+                path: file,
+                lines: lines.as_deref().map(parse_lines).transpose()?,
+                side: if old { Side::Old } else { Side::New },
+                quote,
+                round,
+                body: text_of(body, cwd)?,
+            };
+            if ctx.dry_run {
+                println!("[dry-run] would draft on {review}");
+                return Ok(0);
+            }
+            let draft = drafts::add_draft(&project, &reference(&review), new)?;
+            if ctx.json {
+                print_json(&as_json!(&draft));
+            } else {
+                println!("{review}: drafted {}", draft_line(&draft));
+            }
+        }
+        DraftCommand::List { review, agent } => {
+            let project = opened(cwd, agent.as_deref())?;
+            let listed = drafts::list_drafts(&project, &reference(&review))?;
+            if ctx.json {
+                print_json(&json!({ "review": review, "drafts": as_json!(&listed) }));
+            } else if listed.is_empty() {
+                println!("{review}: no drafts");
+            } else {
+                for draft in &listed {
+                    println!("{}", draft_line(draft));
+                }
+            }
+        }
+        DraftCommand::Edit {
+            review,
+            draft,
+            body,
+            agent,
+        } => {
+            let project = opened(cwd, agent.as_deref())?;
+            let update = DraftUpdate {
+                body: text_of(body, cwd)?,
+            };
+            if ctx.dry_run {
+                println!("[dry-run] would change {draft} on {review}");
+                return Ok(0);
+            }
+            let changed = drafts::update_draft(&project, &reference(&review), &draft, &update)?;
+            if ctx.json {
+                print_json(&as_json!(&changed));
+            } else {
+                println!("{review}: changed {}", draft_line(&changed));
+            }
+        }
+        DraftCommand::Remove {
+            review,
+            draft,
+            agent,
+        } => {
+            let project = opened(cwd, agent.as_deref())?;
+            if ctx.dry_run {
+                println!("[dry-run] would remove {draft} from {review}");
+                return Ok(0);
+            }
+            drafts::remove_draft(&project, &reference(&review), &draft)?;
+            if ctx.json {
+                print_json(&json!({ "review": review, "draft": draft, "removed": true }));
+            } else {
+                println!("{review}: removed {draft}");
+            }
+        }
+    }
+    Ok(0)
+}
+
+pub(super) fn parse_lines(lines: &str) -> Result<(u32, u32)> {
+    let bad = || Error::Invalid(format!("--lines takes A-B or A, not {lines}"));
+    let (first, last) = lines.split_once('-').unwrap_or((lines, lines));
+    let (first, last): (u32, u32) = (
+        first.parse().map_err(|_| bad())?,
+        last.parse().map_err(|_| bad())?,
+    );
+    if first == 0 || last < first {
+        return Err(bad());
+    }
+    Ok((first, last))
+}
