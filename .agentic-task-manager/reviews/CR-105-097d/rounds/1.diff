-            cursor.seen.into_iter().collect(),
-            cursor.statuses,
-            written_at(&watch_file),
-        )
-    } else {
-        let (seen, statuses) = starting_point(store, &file, None)?;
-        (seen, statuses, written_at(&file))
-    };
-    save_cursor(&file, &mut seen, &mut statuses);
