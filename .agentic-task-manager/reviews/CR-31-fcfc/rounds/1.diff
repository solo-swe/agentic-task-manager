+      'docs/plan.md',
+      'pnpm-lock.yaml',
+      'src/main.rs',
+    ].map((p) => file(p));
+    const ordered = treeOrder(git);
+    expect(paths(ordered)).toEqual([
+      'crates/a/src/lib.rs',
