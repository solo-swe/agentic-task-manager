index b6190cb8..1ca7f637 100644
--- a/dashboard/src/lib/prefs.ts
+++ b/dashboard/src/lib/prefs.ts
@@ -43,6 +43,8 @@ export interface Prefs {
   needsYouBadge: boolean;
