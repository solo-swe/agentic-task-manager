+    .expect("a review");
+    assert_eq!(opened["reference"], json!("CR-1"), "{opened}");
+    assert_eq!(opened["title"], json!("The README"), "{opened}");
+    let review = |extra: Value| {
+        let mut args = on(json!({"review": "CR-1"}));
+        args.as_object_mut()
+            .expect("an object")
+            .extend(extra.as_object().expect("an object").clone());
+        args
+    };
+    let added = call(
+        window,
+        "add_review_comment",
