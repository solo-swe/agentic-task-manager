+        window,
+        "poke_review",
+        &review(json!({"body": "Where are we?"})),
+    )
+    .expect("a poke");
+    assert_eq!(poked["review"], json!("CR-1"), "{poked}");
+    assert!(poked["poke"].is_string(), "{poked}");
+    assert_eq!(
+        call(
+            window,
+            "update_review_comment",
+            &review(json!({"comment": comment, "update": {"body": "Why so?"}})),
